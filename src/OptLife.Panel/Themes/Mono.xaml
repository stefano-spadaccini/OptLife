<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ════════════════════════════════════════════════════════════════════
         Theme: Mono
         Pure black and white, sharp corners, monospace labels — the same look
         as the Steam profile and the Discord themes. Colour appears only where
         it means something: amber for "watch this", red for "serious".
         Token names follow one common scheme, so other themes drop in unchanged.
         ════════════════════════════════════════════════════════════════════ -->

    <!-- ── Surfaces (depth) ─────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="Surface.Base"    Color="#000000"/>
    <SolidColorBrush x:Key="Surface.Raised"  Color="#0B0B0B"/>
    <SolidColorBrush x:Key="Surface.Overlay" Color="#171717"/>
    <SolidColorBrush x:Key="Surface.Sunken"  Color="#050505"/>
    <!-- The opaque colour under everything (Mica or not), and the background of menus and pop-ups -->
    <SolidColorBrush x:Key="Surface.Solid"   Color="#000000"/>
    <SolidColorBrush x:Key="Surface.Flyout"  Color="#121212"/>

    <!-- ── Outlines ─────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="Outline.Subtle"  Color="#232323"/>
    <SolidColorBrush x:Key="Outline.Strong"  Color="#3D3D3D"/>

    <!-- ── Text ─────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="Text.Primary"    Color="#F4F4F4"/>
    <SolidColorBrush x:Key="Text.Secondary"  Color="#AAAAAA"/>
    <SolidColorBrush x:Key="Text.Muted"      Color="#8E8E8E"/>
    <SolidColorBrush x:Key="Text.OnAccent"   Color="#000000"/>

    <!-- ── Accent (signature): white ────────────────────────────────────── -->
    <SolidColorBrush x:Key="Accent"          Color="#FFFFFF"/>
    <!-- Buttons and switches: the accent adjusted so the text on it reads at 4.5:1 -->
    <SolidColorBrush x:Key="Accent.Fill"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Accent.Hover"    Color="#DADADA"/>
    <SolidColorBrush x:Key="Accent.Pressed"  Color="#B4B4B4"/>
    <SolidColorBrush x:Key="Accent.Subtle"   Color="#151515"/>

    <!-- ── Status ───────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="Success"         Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Warning"         Color="#E0A82E"/>
    <SolidColorBrush x:Key="Danger"          Color="#E52B3F"/>
    <SolidColorBrush x:Key="Info"            Color="#8C8C8C"/>
    <!-- "Set up right", on the Setup page only: the one place where green says more than white -->
    <SolidColorBrush x:Key="Good"            Color="#4FC27A"/>

    <!-- ── Shape ────────────────────────────────────────────────────────── -->
    <CornerRadius x:Key="Radius.Control">4</CornerRadius>
    <CornerRadius x:Key="Radius.Card">8</CornerRadius>
    <CornerRadius x:Key="Radius.Window">8</CornerRadius>
    <Thickness    x:Key="Border.Width">1</Thickness>

    <!-- ── Typography ───────────────────────────────────────────────────── -->
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="Font.Body">Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Code, Consolas, monospace</FontFamily>
    <!-- Windows 11 icons, with the Windows 10 set where they are missing -->
    <FontFamily x:Key="Font.Icon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- The zoom of pop-ups (Windows text size × panel size), set by the window -->
    <ScaleTransform x:Key="UiScale" ScaleX="1" ScaleY="1"/>

    <!-- ── Materials (glass) ────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="Material.Glass" Color="#000000" Opacity="0.92"/>

</ResourceDictionary>
