<Window x:Class="OptLife.Panel.BigLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OptLife.Panel"
        Title="OptLife" WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        Background="#FF0B0B0C" Foreground="#FFF2F2F2" FontFamily="Segoe UI Variable Text, Segoe UI"
        AutomationProperties.Name="{local:T 'Libreria a schermo intero', 'Full-screen library'}">
    <Window.Resources>
        <!-- Fixed dark colours, for a TV seen from afar: white text on near-black is above 15:1 -->
        <SolidColorBrush x:Key="BigDim" Color="#FFC4C4C4"/>
        <SolidColorBrush x:Key="BigCardBack" Color="#FF1C1C1F"/>
        <SolidColorBrush x:Key="BigPanel" Color="#F2141416"/>

        <!-- A key or entry of a list moved with the controller: white frame when chosen, accent dot when it is the current one -->
        <DataTemplate x:Key="ChoiceTemplate">
            <Border x:Name="Entry" Padding="16,9" CornerRadius="6" BorderThickness="3" BorderBrush="Transparent" Margin="0,2"
                    MouseLeftButtonUp="Choice_Click" Tag="{Binding}" Cursor="Hand" AutomationProperties.Name="{Binding Text}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center" Fill="#FFFFFFFF" Visibility="{Binding IsCurrent, Converter={StaticResource Vis}}"/>
                    <TextBlock x:Name="Words" Text="{Binding Text, Converter={StaticResource Sentence}}" FontSize="24"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Entry" Property="BorderBrush" Value="#FFFFFFFF"/>
                    <Setter TargetName="Entry" Property="Background" Value="#FF2A2A2E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHeading}" Value="True">
                    <Setter TargetName="Words" Property="FontSize" Value="16"/>
                    <Setter TargetName="Words" Property="Foreground" Value="{StaticResource BigDim}"/>
                    <Setter TargetName="Entry" Property="Margin" Value="0,12,0,0"/>
                    <Setter TargetName="Entry" Property="Cursor" Value="Arrow"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One button of the legend, drawn: a letter in a coloured circle, a PlayStation symbol, a pill with a word, a key cap -->
        <DataTemplate x:Key="LegendTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,0,30,0" AutomationProperties.Name="{Binding AccessibleName}">
                <Grid x:Name="Badge" Width="34" Height="34" VerticalAlignment="Center">
                    <Ellipse x:Name="Disc" Fill="{Binding Color}" Visibility="Collapsed"/>
                    <TextBlock x:Name="Letter" Text="{Binding Text}" FontSize="17" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <Ellipse x:Name="Ring" Stroke="#FF8A8A90" StrokeThickness="2" Visibility="Collapsed"/>
                    <Path x:Name="Cross" Data="M 11,11 L 23,23 M 23,11 L 11,23" Stroke="{Binding Color}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                    <Ellipse x:Name="CircleShape" Width="13" Height="13" Stroke="{Binding Color}" StrokeThickness="3" Visibility="Collapsed"/>
                    <Rectangle x:Name="SquareShape" Width="12" Height="12" Stroke="{Binding Color}" StrokeThickness="3" Visibility="Collapsed"/>
                    <Path x:Name="TriangleShape" Data="M 17,10 L 24,22 L 10,22 Z" Stroke="{Binding Color}" StrokeThickness="3" StrokeLineJoin="Round" Visibility="Collapsed"/>
                </Grid>
                <Border x:Name="Pill" CornerRadius="12" BorderThickness="2" BorderBrush="#FF8A8A90" Padding="10,2" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="{Binding Text}" FontSize="14" FontWeight="SemiBold"/>
                </Border>
                <Border x:Name="KeyCap" CornerRadius="5" BorderThickness="2,2,2,4" BorderBrush="#FF8A8A90" Background="#FF26262A" Padding="9,2" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="{Binding Text}" FontSize="15" FontWeight="SemiBold"/>
                </Border>
                <TextBlock Text="{Binding Label}" FontSize="20" Foreground="{StaticResource BigDim}" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Shape}" Value="letter">
                    <Setter TargetName="Disc" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Letter" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Shape}" Value="cross">
                    <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Cross" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Shape}" Value="circle">
                    <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="CircleShape" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Shape}" Value="square">
                    <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="SquareShape" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Shape}" Value="triangle">
                    <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="TriangleShape" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Shape}" Value="pill">
                    <Setter TargetName="Pill" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Badge" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Shape}" Value="key">
                    <Setter TargetName="KeyCap" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Badge" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Background: the chosen cover's own colour as a gradient, and the cover itself decoded tiny and stretched (soft, at no cost) -->
        <Grid IsHitTestVisible="False">
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                        <GradientStop Color="{Binding Selected.Card.Picture, Converter={StaticResource CoverColor}}" Offset="0"/>
                        <GradientStop Color="#FF0B0B0C" Offset="0.85"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Image Source="{Binding Selected.Card.Picture, Converter={StaticResource SoftImage}}" Stretch="UniformToFill" Opacity="0.22"
                   RenderOptions.BitmapScalingMode="Linear"/>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#550B0B0C" Offset="0"/>
                        <GradientStop Color="#CC0B0B0C" Offset="0.7"/>
                        <GradientStop Color="#F00B0B0C" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <Grid Margin="56,36,56,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="560"/>
            </Grid.ColumnDefinitions>

            <!-- Top: the library, the order and filter in words, the time -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{local:T Libreria, Library}" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Showing}" FontSize="19" Foreground="{StaticResource BigDim}" VerticalAlignment="Bottom" Margin="18,0,0,4"/>
            </StackPanel>
            <TextBlock Grid.Column="1" x:Name="Clock" FontSize="26" Foreground="{StaticResource BigDim}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

            <!-- The grid of covers, all the same size; the chosen one has a thick white frame and is slightly larger -->
            <ScrollViewer x:Name="RowsScroll" Grid.Row="1" Margin="0,16,24,0" Padding="0,14,0,14" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" HorizontalAlignment="Left">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,4" AutomationProperties.Name="{Binding AccessibleName}">
                                <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="SemiBold" Margin="8,10,0,4" Visibility="{Binding HasName, Converter={StaticResource Vis}}"/>
                                <ItemsControl ItemsSource="{Binding Cards}" Focusable="False">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Frame" Width="196" Height="270" Margin="8,10,8,10" CornerRadius="8" BorderThickness="4" BorderBrush="Transparent"
                                                    Background="{StaticResource BigCardBack}" RenderTransformOrigin="0.5,0.5" Cursor="Hand" ClipToBounds="True"
                                                    MouseLeftButtonUp="Card_Click" Tag="{Binding}"
                                                    AutomationProperties.Name="{Binding Card.AccessibleName}">
                                                <Grid>
                                                    <StackPanel VerticalAlignment="Center" Margin="12,0" Visibility="{Binding Card.HasImage, Converter={StaticResource Vis}, ConverterParameter=not}">
                                                        <TextBlock Text="{Binding Card.Initial}" FontSize="64" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource BigDim}"/>
                                                        <TextBlock Text="{Binding Card.Title}" FontSize="19" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                                    </StackPanel>
                                                    <Image Source="{Binding Card.Picture, Converter={StaticResource SoftImage}}" Stretch="UniformToFill" Opacity="0.55" RenderOptions.BitmapScalingMode="Linear"/>
                                                    <Image Source="{Binding Card.Picture, Converter={StaticResource FileImage}}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Frame" Property="BorderBrush" Value="#FFFFFFFF"/>
                                                    <Setter TargetName="Frame" Property="RenderTransform">
                                                        <Setter.Value><ScaleTransform ScaleX="1.06" ScaleY="1.06"/></Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="1" Text="{local:T 'Nessun gioco con questi filtri.', 'No games with these filters.'}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}"/>

            <!-- Right: the chosen game, big: its picture fading into the panel, the logo, the facts OptLife knows, two buttons -->
            <Border Grid.Row="1" Grid.Column="1" Margin="0,16,0,0" CornerRadius="14" Background="#B0141416" ClipToBounds="True"
                    Visibility="{Binding IsEmpty, Converter={StaticResource Vis}, ConverterParameter=not}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="380"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.RowSpan="2" VerticalAlignment="Top" Height="460">
                        <Grid.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FF000000" Offset="0.55"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Grid.OpacityMask>
                        <Image Source="{Binding Selected.Card.Hero, Converter={StaticResource SoftImage}}" Stretch="UniformToFill" Opacity="0.6" RenderOptions.BitmapScalingMode="Linear"/>
                        <Image Source="{Binding Selected.Card.Hero, Converter={StaticResource LargeImage}}" Stretch="UniformToFill" StretchDirection="DownOnly" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="{Binding Selected.Card.Initial}" FontSize="120" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource BigDim}" Visibility="{Binding Selected.Card.HasImage, Converter={StaticResource Vis}, ConverterParameter=not}"/>
                    </Grid>
                    <Image Grid.Row="0" Source="{Binding Selected.Card.Logo, Converter={StaticResource FileImage}}" MaxHeight="110" MaxWidth="380" Stretch="Uniform"
                           HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="28,0,0,10" Visibility="{Binding Selected.Card.HasLogo, Converter={StaticResource Vis}}"/>
                    <StackPanel Grid.Row="1" Margin="28,10,28,20">
                        <TextBlock Text="{Binding Selected.Card.Title}" FontSize="34" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="130" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Selected.Card.HasLogo, Converter={StaticResource Vis}, ConverterParameter=not}"/>
                        <TextBlock Text="{Binding Selected.Card.Line}" FontSize="21" Foreground="#FFE8E8E8" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding Selected.Card.Details}" Margin="0,10,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Ellipse Width="6" Height="6" Fill="#FFC4C4C4" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding}" FontSize="18" Foreground="{StaticResource BigDim}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Tab.Notice}" FontSize="18" Foreground="#FFFFFFFF" Margin="0,10,0,0" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" Visibility="{Binding Tab.Notice, Converter={StaticResource Vis}}"/>
                        <WrapPanel Margin="0,18,0,0">
                            <Border CornerRadius="24" Background="#33FFFFFF" BorderBrush="#FFFFFFFF" BorderThickness="2" Padding="10,8,0,8" Margin="0,0,12,8">
                                <ContentControl Content="{Binding Legend[0]}" ContentTemplate="{StaticResource LegendTemplate}" Focusable="False"/>
                            </Border>
                            <Border CornerRadius="24" BorderBrush="#99FFFFFF" BorderThickness="2" Padding="10,8,0,8" Margin="0,0,0,8"
                                    Visibility="{Binding Selected.Card.HasMore, Converter={StaticResource Vis}}">
                                <ContentControl Content="{Binding MenuKey}" ContentTemplate="{StaticResource LegendTemplate}" Focusable="False"/>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- What each button does, drawn in the shapes and colours of the controller in use -->
            <ItemsControl Grid.Row="2" Grid.ColumnSpan="2" Margin="0,14,0,0" ItemsSource="{Binding Legend}" ItemTemplate="{StaticResource LegendTemplate}" Focusable="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- The game's menu -->
            <Border Grid.RowSpan="3" Grid.ColumnSpan="2" Background="#CC000000" Visibility="{Binding MenuOpen, Converter={StaticResource Vis}}" Margin="-56,-36,-56,-28">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="520" Padding="24" CornerRadius="10" Background="{StaticResource BigPanel}">
                    <StackPanel>
                        <TextBlock Text="{Binding Selected.Card.Title}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding Menu}" ItemTemplate="{StaticResource ChoiceTemplate}" Focusable="False"/>
                        <TextBlock FontSize="18" Foreground="{StaticResource BigDim}" Margin="0,16,0,0">
                            <Run Text="{Binding AcceptName, Mode=OneWay}"/><Run Text="{local:T ': scegli · ', ': choose · '}"/><Run Text="{Binding BackName, Mode=OneWay}"/><Run Text="{local:T ': indietro', ': back'}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Order and filters -->
            <Border Grid.RowSpan="3" Grid.ColumnSpan="2" Background="#CC000000" Visibility="{Binding FiltersOpen, Converter={StaticResource Vis}}" Margin="-56,-36,-56,-28">
                <Border HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="480" Padding="32,40" Background="{StaticResource BigPanel}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{local:T 'Ordine e filtri', 'Order and filters'}" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock DockPanel.Dock="Bottom" FontSize="18" Foreground="{StaticResource BigDim}" Margin="0,16,0,0">
                            <Run Text="{Binding AcceptName, Mode=OneWay}"/><Run Text="{local:T ': applica · ', ': apply · '}"/><Run Text="{Binding BackName, Mode=OneWay}"/><Run Text="{local:T ': chiudi', ': close'}"/>
                        </TextBlock>
                        <ScrollViewer x:Name="FiltersScroll" VerticalScrollBarVisibility="Hidden" Focusable="False">
                            <ItemsControl ItemsSource="{Binding Filters}" ItemTemplate="{StaticResource ChoiceTemplate}" Focusable="False"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Border>

            <!-- On-screen keyboard: the search typed with the controller -->
            <Border Grid.RowSpan="3" Grid.ColumnSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Padding="24" CornerRadius="12" Background="{StaticResource BigPanel}"
                    Visibility="{Binding KeyboardOpen, Converter={StaticResource Vis}}" Margin="0,0,0,40">
                <StackPanel>
                    <Border Padding="14,8" CornerRadius="6" Background="#FF2A2A2E" Margin="0,0,0,14">
                        <TextBlock FontSize="28" AutomationProperties.LiveSetting="Polite">
                            <Run Text="{local:T 'Cerca:', 'Search:'}" Foreground="{StaticResource BigDim}"/>
                            <Run Text="{Binding Tab.GallerySearch, Mode=OneWay}"/><Run Text="|" Foreground="#FFFFFFFF"/>
                        </TextBlock>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Keys}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding}" Focusable="False" HorizontalAlignment="Center">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Key" MinWidth="58" Height="54" Margin="3" CornerRadius="6" BorderThickness="3" BorderBrush="Transparent" Background="#FF26262A"
                                                    MouseLeftButtonUp="Key_Click" Tag="{Binding}" Cursor="Hand" AutomationProperties.Name="{Binding Text}">
                                                <TextBlock Text="{Binding Text}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Key" Property="BorderBrush" Value="#FFFFFFFF"/>
                                                    <Setter TargetName="Key" Property="Background" Value="#FF3A3A40"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock FontSize="18" Foreground="{StaticResource BigDim}" Margin="0,12,0,0" HorizontalAlignment="Center">
                        <Run Text="{Binding AcceptName, Mode=OneWay}"/><Run Text="{local:T ': scrivi · ', ': type · '}"/><Run Text="{Binding DeleteName, Mode=OneWay}"/><Run Text="{local:T ': cancella · ', ': delete · '}"/><Run Text="{Binding BackName, Mode=OneWay}"/><Run Text="{local:T ': chiudi', ': close'}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Leaving asks first -->
            <Border Grid.RowSpan="3" Grid.ColumnSpan="2" Background="#DD000000" Visibility="{Binding ExitOpen, Converter={StaticResource Vis}}" Margin="-56,-36,-56,-28">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="36,28" CornerRadius="12" Background="{StaticResource BigPanel}">
                    <StackPanel>
                        <TextBlock Text="{x:Static local:BigLibraryWindow.ExitText}" FontSize="30" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Center">
                            <ContentControl Content="{Binding ExitYes}" ContentTemplate="{StaticResource LegendTemplate}" Focusable="False"/>
                            <ContentControl Content="{Binding ExitNo}" ContentTemplate="{StaticResource LegendTemplate}" Focusable="False"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Help -->
            <Border Grid.RowSpan="3" Grid.ColumnSpan="2" Background="#EE000000" Visibility="{Binding HelpOpen, Converter={StaticResource Vis}}" Margin="-56,-36,-56,-28">
                <TextBlock Text="{Binding HelpLines, Mode=OneTime}" FontSize="28" TextWrapping="Wrap" MaxWidth="1100" LineHeight="44"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Read aloud by screen readers after each move -->
            <TextBlock Text="{Binding Announcement}" AutomationProperties.LiveSetting="Assertive" Width="1" Height="1" Opacity="0" Focusable="False"/>
        </Grid>
    </Grid>
</Window>
