<Window x:Class="OptLife.Panel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OptLife.Panel"
        Title="OptLife" Width="1120" Height="760" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface.Base}"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{DynamicResource Font.Body}" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- The dot or bar of a level with its icon: drawn next to every coloured state -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Display}"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        </Style>
        <Style x:Key="SectionHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="Margin" Value="0,6,0,10"/>
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level2"/>
        </Style>
        <!-- Shown when the pointer is on its row or the keyboard is inside it: secondary actions stay out of the way
             but can always be reached with Tab (they are only see-through, never removed). -->
        <Style x:Key="OnHover" TargetType="FrameworkElement">
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=1}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=1}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- One setting of a module: shared by the Settings page and a module's own Form page -->
        <DataTemplate x:Key="SettingRow">
            <StackPanel Visibility="{Binding Shown, Converter={StaticResource Vis}}">
            <!-- Where a group of settings starts: its heading, so a long list reads in parts -->
            <TextBlock Text="{Binding GroupHeader}" FontSize="15" FontWeight="SemiBold" Margin="0,22,0,0"
                       Visibility="{Binding HasGroupHeader, Converter={StaticResource Vis}}" AutomationProperties.HeadingLevel="Level3"/>
            <Grid Margin="0,14,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*" MinWidth="140"/>
                    <ColumnDefinition Width="*" MaxWidth="340"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" FontSize="12.5" Margin="0,2,0,0"/>
                </StackPanel>
                <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding BoolValue}" HorizontalAlignment="Right" VerticalAlignment="Top"
                          Visibility="{Binding IsBool, Converter={StaticResource Vis}}" AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Description}"/>
                <TextBox Grid.Column="1" Style="{StaticResource Field}" VerticalAlignment="Top" Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsLine, Converter={StaticResource Vis}}" AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Description}"/>
                          <StackPanel Grid.Column="1" VerticalAlignment="Top" Visibility="{Binding IsPick, Converter={StaticResource Vis}}">
                              <ComboBox Style="{StaticResource Pick}" ItemsSource="{Binding Picks}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding PickedValue}"
                                        AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Description}"/>
                              <Button Style="{StaticResource BtnSubtle}" HorizontalAlignment="Left" Margin="-6,4,0,0" Click="Browse_Click" Visibility="{Binding IsFolder, Converter={StaticResource Vis}}"
                                      ToolTip="{local:T 'Scegli un\'altra cartella con la finestra di Windows', 'Choose another folder with the Windows window'}">
                                  <StackPanel Orientation="Horizontal">
                                      <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="13"/>
                                      <TextBlock Text="{local:T Sfoglia…, Browse…}" Margin="8,0,0,0"/>
                                  </StackPanel>
                              </Button>
                          </StackPanel>
                <!-- A list: a table with one box per field, rows added and removed; or the plain text, to paste many at once -->
                <CheckBox Grid.Column="1" Style="{StaticResource Tick}" IsChecked="{Binding AsText}" HorizontalAlignment="Right" VerticalAlignment="Top"
                          Visibility="{Binding ShowTable, Converter={StaticResource Vis}}">
                    <TextBlock Text="{local:T 'Come testo', 'As text'}" FontSize="13"/>
                </CheckBox>
                <!-- A list ticked from what OptLife found (devices); entries written by hand that match nothing found stay below -->
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Visibility="{Binding IsPickList, Converter={StaticResource Vis}}">
                    <ItemsControl ItemsSource="{Binding PickChecks}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource Tick}" IsChecked="{Binding IsChecked}" Margin="0,4" AutomationProperties.Name="{Binding Label}">
                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="ExtraLabel" Text="{local:T 'Altri, scritti a mano (uno per riga, anche solo una parte del nome)', 'Others, written by hand (one per line, even just part of the name)'}" Style="{StaticResource Secondary}" FontSize="12.5" Margin="0,8,0,4"/>
                    <TextBox Style="{StaticResource Field}" AcceptsReturn="True" MinHeight="40" MaxHeight="140" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                             Text="{Binding ExtraText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.LabeledBy="{Binding ElementName=ExtraLabel}"/>
                </StackPanel>
                <!-- The simple view of a table (the overlay's values): ready sets, common values to tick, the order of the chosen ones -->
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Visibility="{Binding ShowBasic, Converter={StaticResource Vis}}">
                    <TextBlock Text="{local:T 'Pronti', 'Ready sets'}" Style="{StaticResource Caps}" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding Presets}" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource BtnGhost}" Content="{Binding Label}" Margin="0,0,8,8"
                                        Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- The chosen values under a name: a preset of one's own, which can then be linked to a game -->
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,6" Visibility="{Binding CanSavePreset, Converter={StaticResource Vis}}">
                        <TextBox Style="{StaticResource Field}" Width="220" Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{local:T 'Nome del nuovo preset', 'Name of the new preset'}"
                                 ToolTip="{local:T 'Per esempio: Overwatch, Solo rete', 'For example: Overwatch, Network only'}"/>
                        <Button Style="{StaticResource BtnGhost}" Margin="8,0,0,0" Content="{local:T 'Salva come preset', 'Save as preset'}" Command="{Binding SavePresetCommand}"
                                ToolTip="{local:T 'I valori scelti, con questo nome, nei tuoi preset (poi Salva in fondo)', 'The chosen values, with this name, into your presets (then Save at the bottom)'}"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding BasicGroups}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Caps}" Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding Chips}" Focusable="False">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Style="{StaticResource ChoiceCard}" Width="250" IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Label}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="16" Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="170"/>
                                                    </StackPanel>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="OrderLabel" Text="{local:T 'In quest\'ordine (trascina, o usa le frecce)', 'In this order (drag, or use the arrows)'}" Style="{StaticResource Caps}" Margin="0,10,0,6"/>
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" AutomationProperties.LabeledBy="{Binding ElementName=OrderLabel}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="{DynamicResource Radius.Control}" BorderThickness="1" BorderBrush="{DynamicResource Outline.Strong}" Background="{DynamicResource Surface.Overlay}"
                                        Margin="0,0,6,6" Padding="4,2" AllowDrop="True" Cursor="SizeAll"
                                        MouseMove="OrderChip_MouseMove" Drop="OrderChip_Drop" AutomationProperties.Name="{Binding Title}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource IconBtn}" Content="&#xE76B;" Command="{Binding MoveUpCommand}"
                                                ToolTip="{local:T 'Più avanti', 'Earlier'}" AutomationProperties.Name="{local:T 'Sposta prima', 'Move earlier'}"/>
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Margin="4,0" MaxWidth="320" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                        <Button Style="{StaticResource IconBtn}" Content="&#xE76C;" Command="{Binding MoveDownCommand}"
                                                ToolTip="{local:T 'Più indietro', 'Later'}" AutomationProperties.Name="{local:T 'Sposta dopo', 'Move later'}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Visibility="{Binding ShowTable, Converter={StaticResource Vis}}">
                    <TextBox Style="{StaticResource Field}" AcceptsReturn="True" MinHeight="64" MaxHeight="220"
                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label}"
                             Visibility="{Binding AsText, Converter={StaticResource Vis}}"/>
                    <StackPanel Visibility="{Binding AsText, Converter={StaticResource Vis}, ConverterParameter=not}">
                        <!-- Column names -->
                        <ItemsControl ItemsSource="{Binding Columns}" Margin="0,0,102,4" Visibility="{Binding HasColumnNames, Converter={StaticResource Vis}}" Focusable="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource Sentence}}" Style="{StaticResource Caps}" FontSize="11.5" Margin="2,0,6,0" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ItemsControl ItemsSource="{Binding Cells}" Focusable="False">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,6,0">
                                                        <TextBox Style="{StaticResource Field}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Value}"
                                                                 Visibility="{Binding IsTyped, Converter={StaticResource Vis}}"/>
                                                        <!-- A field picked from what the module found (a live value, a game, a colour) -->
                                                        <ComboBox Style="{StaticResource Pick}" ItemsSource="{Binding Picks}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                                  SelectedValue="{Binding PickedValue}" Visibility="{Binding IsPick, Converter={StaticResource Vis}}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Style="{StaticResource IconBtn}" Content="&#xE70E;" Command="{Binding MoveUpCommand}"
                                                    ToolTip="{local:T Sposta su, Move up}" AutomationProperties.Name="{local:T Sposta su, Move up}"/>
                                            <Button Style="{StaticResource IconBtn}" Content="&#xE70D;" Command="{Binding MoveDownCommand}"
                                                    ToolTip="{local:T Sposta giù, Move down}" AutomationProperties.Name="{local:T Sposta giù, Move down}"/>
                                            <Button Style="{StaticResource IconBtn}" Content="&#xE8C8;" Command="{Binding DuplicateCommand}"
                                                    ToolTip="{local:T 'Duplica questa riga', 'Duplicate this row'}" AutomationProperties.Name="{local:T 'Duplica questa riga', 'Duplicate this row'}"/>
                                            <Button Style="{StaticResource IconBtn}" Content="&#xE711;" Command="{Binding RemoveCommand}"
                                                    ToolTip="{local:T Togli questa riga, Remove this row}" AutomationProperties.Name="{local:T Togli questa riga, Remove this row}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource BtnSubtle}" Command="{Binding AddRowCommand}" HorizontalAlignment="Left" Margin="-8,4,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12"/>
                                <TextBlock Text="{local:T 'Aggiungi una riga', 'Add a row'}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
                <ListBox Grid.Column="1" Style="{StaticResource Choices}" VerticalAlignment="Top" HorizontalAlignment="Right"
                         ItemsSource="{Binding Options}" SelectedItem="{Binding TextValue}" AutomationProperties.Name="{Binding Label}"
                         Visibility="{Binding IsChoice, Converter={StaticResource Vis}}"/>
            </Grid>
            </StackPanel>
        </DataTemplate>
        <!-- Save, defaults and what happened, for a module (ModuleItem) -->
        <DataTemplate x:Key="ModuleSaveRow">
            <StackPanel Orientation="Horizontal" Margin="0,20,0,4">
                <Button Style="{StaticResource BtnPrimary}" Content="{local:T Salva, Save}" Command="{Binding SaveCommand}"/>
                <Button Style="{StaticResource BtnGhost}" Content="{local:T 'Valori iniziali', 'Defaults'}" Command="{Binding ResetDefaultsCommand}" Margin="10,0,0,0"
                        ToolTip="{local:T Riporta tutte le impostazioni di questo modulo ai valori iniziali, Puts all the settings of this module back to their initial values}"/>
                <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap" MaxWidth="460" AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <!-- The title bar is part of the page: one surface (Mica or the theme colour) from the top edge down, normal or maximised.
         Its own minimise / maximise / close buttons are drawn at the top right; the maximise one opens Windows' snap layouts. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ SIDE BAR ═══════════════════════════════════════════════════ -->
        <Border x:Name="SideBar" Padding="6,8,6,8" AutomationProperties.Name="{local:T Navigazione, Navigation}"
                KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="248"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NavIconsOnly}" Value="True">
                            <Setter Property="Width" Value="56"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <!-- Collapse the bar to its icons -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Style="{StaticResource BtnSubtle}" Width="44" Height="38" Command="{Binding ToggleNavCommand}" WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="{local:T 'Mostra o nascondi i nomi delle pagine', 'Show or hide the page names'}"
                            AutomationProperties.Name="{local:T 'Mostra o nascondi i nomi delle pagine', 'Show or hide the page names'}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE700;"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding NavIconsOnly, Converter={StaticResource Vis}, ConverterParameter=not}">
                        <Ellipse Width="13" Height="13" Stroke="{DynamicResource Accent}" StrokeThickness="3" Margin="0,0,9,0"/>
                        <TextBlock Text="OptLife" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Bottom: the history and the settings -->
                <StackPanel DockPanel.Dock="Bottom" DataContext="{Binding}">
                    <Border Height="1" Background="{DynamicResource Outline.Subtle}" Margin="8,6"/>
                    <Button Style="{StaticResource NavEntry}" Tag="{Binding HistoryGroup.IsSelected}" Command="{Binding HistoryGroup.ActivateCommand}"
                            ToolTip="{Binding HistoryGroup.ToolTipText}" AutomationProperties.Name="{Binding HistoryGroup.Label}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="{Binding HistoryGroup.Icon}" Width="20"/>
                            <TextBlock Text="{Binding HistoryGroup.Label}" Margin="14,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding DataContext.NavIconsOnly, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}, ConverterParameter=not}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavEntry}" Tag="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Modules}"
                            Command="{Binding ShowCommand}" CommandParameter="Modules"
                            ToolTip="{local:T Impostazioni, Settings}" AutomationProperties.Name="{local:T Impostazioni, Settings}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Width="20"/>
                            <TextBlock Text="{local:T Impostazioni, Settings}" Margin="14,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding NavIconsOnly, Converter={StaticResource Vis}, ConverterParameter=not}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Button Style="{StaticResource NavEntry}" Tag="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Monitor}"
                                Command="{Binding ShowCommand}" CommandParameter="Monitor"
                                ToolTip="Home (Ctrl+1)" AutomationProperties.Name="Home">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" Width="20"/>
                                <TextBlock Text="Home" Margin="14,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding NavIconsOnly, Converter={StaticResource Vis}, ConverterParameter=not}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ProblemsEntry" Style="{StaticResource NavEntry}" HorizontalContentAlignment="Stretch" Tag="{Binding InProblems}" Command="{Binding ShowProblemsCommand}" CommandParameter="Open"
                                ToolTip="{local:T 'Problemi (Ctrl+2)', 'Problems (Ctrl+2)'}">
                            <AutomationProperties.Name>
                                <MultiBinding StringFormat="{}{0}: {1}">
                                    <Binding Source="{local:T Problemi, Problems}"/>
                                    <Binding Path="OpenCount"/>
                                </MultiBinding>
                            </AutomationProperties.Name>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="20">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;"/>
                                        <!-- A dot on the icon when the bar is narrow: there are problems -->
                                        <Border Width="8" Height="8" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0"
                                                Style="{StaticResource LevelFill}" Tag="{Binding StatusLevel}"
                                                Visibility="{Binding ShowCountDot, Converter={StaticResource Vis}}"/>
                                    </Grid>
                                    <TextBlock Text="{local:T Problemi, Problems}" Margin="14,0,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding NavIconsOnly, Converter={StaticResource Vis}, ConverterParameter=not}"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" CornerRadius="9" MinWidth="20" Height="18" Padding="6,0" Margin="0,0,2,0"
                                        Background="{DynamicResource Accent.Fill}" Visibility="{Binding ShowCountBadge, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{Binding OpenCount}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.OnAccent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>

                        <ItemsControl ItemsSource="{Binding TopGroups}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Heading}" Style="{StaticResource Caps}" Margin="12,16,0,6"
                                                   AutomationProperties.HeadingLevel="Level2">
                                            <TextBlock.Visibility>
                                                <MultiBinding Converter="{StaticResource HeadingVis}">
                                                    <Binding Path="HasHeading"/>
                                                    <Binding Path="DataContext.NavIconsOnly" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                </MultiBinding>
                                            </TextBlock.Visibility>
                                        </TextBlock>
                                        <Border Height="1" Background="{DynamicResource Outline.Subtle}" Margin="8,8"
                                                Visibility="{Binding DataContext.NavIconsOnly, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasHeading}" Value="False"><Setter Property="Height" Value="0"/><Setter Property="Margin" Value="0"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <Button Style="{StaticResource NavEntry}" Tag="{Binding IsSelected}" Command="{Binding ActivateCommand}"
                                                ToolTip="{Binding ToolTipText}" AutomationProperties.Name="{Binding Label}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" Width="20"/>
                                                <TextBlock Text="{Binding Label}" Margin="14,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding DataContext.NavIconsOnly, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}, ConverterParameter=not}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ══ CONTENT ════════════════════════════════════════════════════ -->
        <Border x:Name="PageArea" Grid.Column="1" ScrollViewer.ScrollChanged="PageArea_ScrollChanged"
                Background="{DynamicResource Surface.Raised}" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
                BorderBrush="{DynamicResource Outline.Subtle}" KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Top: search everything, the bell ───────────────────────── -->
            <Grid Margin="28,14,150,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="420"/>
                    <ColumnDefinition Width="*" MinWidth="56"/>
                </Grid.ColumnDefinitions>
                <Grid Margin="0,0,12,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBox x:Name="SearchBox" Style="{StaticResource Field}" Text="{Binding GlobalQuery, UpdateSourceTrigger=PropertyChanged}"
                             Padding="32,6,8,6" PreviewKeyDown="SearchBox_PreviewKeyDown"
                             AutomationProperties.Name="{local:T 'Cerca ovunque', 'Search everything'}"
                             AutomationProperties.HelpText="{local:T 'Pagine, problemi, impostazioni, programmi, valori. Ctrl+F per arrivarci da ogni pagina.', 'Pages, problems, settings, programs, values. Ctrl+F to get here from any page.'}"/>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="14" Margin="11,0,0,0" IsHitTestVisible="False" Foreground="{DynamicResource Text.Secondary}"/>
                    <TextBlock Text="{local:T 'Cerca ovunque   (Ctrl+F)', 'Search everything   (Ctrl+F)'}" Margin="33,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               FontSize="13" Foreground="{DynamicResource Text.Secondary}"
                               Visibility="{Binding GlobalQuery, Converter={StaticResource Vis}, ConverterParameter=not}"/>
                    <Popup x:Name="SearchPopup" IsOpen="{Binding SearchOpen}" StaysOpen="False" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom"
                           AllowsTransparency="True" Width="560" VerticalOffset="6">
                        <Border Style="{StaticResource MenuBox}" Margin="0,0,16,16">
                            <StackPanel>
                                <TextBlock Text="{Binding SearchEmptyText}" Style="{StaticResource Secondary}" Margin="16,8"
                                           Visibility="{Binding SearchEmptyText, Converter={StaticResource Vis}}"/>
                                <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="SearchList" ItemsSource="{Binding SearchResults}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource MenuLine}" Command="{Binding DataContext.OpenResultCommand, ElementName=SearchList}" CommandParameter="{Binding}"
                                                        AutomationProperties.Name="{Binding Text}" AutomationProperties.HelpText="{Binding Where}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Where, Converter={StaticResource Sentence}}" Style="{StaticResource Caps}" FontSize="11"/>
                                                        <TextBlock Text="{Binding Text}" Foreground="{DynamicResource Text.Primary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                                   Visibility="{Binding HasDetail, Converter={StaticResource Vis}}"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <!-- The bell: what OptLife is doing now -->
                <Grid Grid.Column="1" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <ToggleButton x:Name="Bell" Style="{StaticResource ToggleSubtle}" IsChecked="{Binding BellOpen}" ToolTip="{Binding BellText}"
                                  AutomationProperties.Name="{Binding BellText}">
                        <Grid>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xEA8F;" Margin="2,0"/>
                            <Border CornerRadius="8" MinWidth="16" Height="16" Padding="4,0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-10,0"
                                    Background="{DynamicResource Accent.Fill}" Visibility="{Binding RunningCount, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding RunningCount}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Text.OnAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </ToggleButton>
                    <Popup IsOpen="{Binding BellOpen}" StaysOpen="False" PlacementTarget="{Binding ElementName=Bell}" Placement="Bottom"
                           HorizontalOffset="-320" VerticalOffset="6" AllowsTransparency="True" Width="380">
                        <Border Style="{StaticResource MenuBox}" Margin="0,0,16,16" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="{Binding BellText}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding Running}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,4,0,10">
                                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Step}" Style="{StaticResource Secondary}" FontSize="12.5" Visibility="{Binding HasStep, Converter={StaticResource Vis}}"/>
                                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}" Margin="0,6,0,2"
                                                             Visibility="{Binding HasFraction, Converter={StaticResource Vis}}" AutomationProperties.Name="{Binding Title}"/>
                                                <TextBlock Text="{Binding When}" Style="{StaticResource Secondary}" FontSize="12"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource BtnSubtle}" HorizontalAlignment="Left" Command="{Binding OpenActivityCommand}" Margin="-8,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{local:T 'Tutte le attività', 'All activities'}"/>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="11" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>

            <!-- ── Page header: title, the short line, "?" ─────────────────── -->
            <Grid Grid.Row="1" Margin="28,18,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}" AutomationProperties.HeadingLevel="Level1"/>
                    <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Secondary}" Margin="0,4,0,0" MaxWidth="860" HorizontalAlignment="Left"
                               Visibility="{Binding PageSubtitle, Converter={StaticResource Vis}}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource BtnGhost}" Margin="0,0,8,0" Command="{Binding RefreshPageCommand}"
                        Visibility="{Binding ShowRefresh, Converter={StaticResource Vis}}"
                        ToolTip="{local:T 'Controlla o rileggi questa pagina adesso (F5)', 'Check or read this page again now (F5)'}"
                        AutomationProperties.Name="{Binding RefreshLabel}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13"/>
                        <TextBlock Text="{Binding RefreshLabel}" Margin="8,0,0,0" FontSize="13"/>
                    </StackPanel>
                </Button>
                <ToggleButton x:Name="HelpButton" Style="{StaticResource ToggleSubtle}" VerticalAlignment="Top" IsChecked="{Binding HelpOpen}"
                              Visibility="{Binding HasHelp, Converter={StaticResource Vis}}"
                              ToolTip="{local:T 'Come si legge questa pagina (F1)', 'How to read this page (F1)'}"
                              AutomationProperties.Name="{local:T 'Aiuto su questa pagina', 'Help on this page'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9CE;"/>
                        <TextBlock Text="{local:T Aiuto, Help}" Margin="8,0,2,0" FontSize="13"/>
                    </StackPanel>
                </ToggleButton>
                </StackPanel>
                <Popup Grid.Column="1" IsOpen="{Binding HelpOpen}" StaysOpen="False" PlacementTarget="{Binding ElementName=HelpButton}" Placement="Bottom"
                       HorizontalOffset="-380" VerticalOffset="6" AllowsTransparency="True" Width="460">
                    <Border Style="{StaticResource MenuBox}" Margin="0,0,16,16" Padding="18,14">
                        <StackPanel>
                            <TextBlock Text="{Binding PageHelp}" TextWrapping="Wrap" LineHeight="20"/>
                            <!-- How to read colours and words: here, not on the page -->
                            <StackPanel Visibility="{Binding HelpHasLegend, Converter={StaticResource Vis}}" Margin="0,14,0,0">
                                <TextBlock Text="{local:T 'Come si leggono i colori', 'How to read the colours'}" Style="{StaticResource Caps}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Style="{StaticResource LevelIcon}" Tag="good" Width="24"/>
                                    <TextBlock Text="{local:T 'Verde, segno di spunta: a posto, oppure acceso', 'Green, tick: fine, or on'}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Style="{StaticResource LevelIcon}" Tag="medium" Width="24"/>
                                    <TextBlock Text="{local:T 'Ambra, triangolo: da guardare', 'Amber, triangle: worth a look'}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Style="{StaticResource LevelIcon}" Tag="high" Width="24"/>
                                    <TextBlock Text="{local:T 'Rosso, cerchio: da sistemare, oppure spento', 'Red, circle: to fix, or off'}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Style="{StaticResource LevelIcon}" Tag="info" Width="24"/>
                                    <TextBlock Text="{local:T 'Grigio, i: informazione o scelta tua', 'Grey, i: information or your choice'}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Secondary}" FontSize="12.5" Margin="0,6,0,0"
                                           Text="{local:T 'Accanto al colore c\'è sempre anche la parola: si legge anche senza distinguere i colori.', 'Next to the colour there is always the word too: it reads without telling colours apart.'}"/>
                            </StackPanel>
                            <TextBlock Text="{local:T Tastiera, Keyboard}" Style="{StaticResource Caps}" Margin="0,14,0,6"/>
                            <TextBlock Style="{StaticResource Secondary}" FontSize="12.5"
                                       Text="{local:T 'Ctrl+F cerca · Ctrl+1…9 le pagine della barra · F5 controlla di nuovo · F1 questo aiuto · Ctrl+più e Ctrl+meno ingrandiscono · Esc chiude', 'Ctrl+F search · Ctrl+1…9 the side bar pages · F5 check again · F1 this help · Ctrl+plus and Ctrl+minus zoom · Esc closes'}"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- ── Tabs: the pages of this side-bar entry, or the problems' filters ── -->
            <Border Grid.Row="2" Margin="24,12,24,0">
                <Grid>
                    <ItemsControl ItemsSource="{Binding CurrentGroup.Items}" Visibility="{Binding ShowTabs, Converter={StaticResource Vis}}" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource Tab}" GroupName="SectionTabs" Content="{Binding Label}"
                                             IsChecked="{Binding IsCurrent, Mode=OneWay}" Command="{Binding GoCommand}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Problems}">
                        <RadioButton Style="{StaticResource Tab}" GroupName="Filter"
                                     IsChecked="{Binding Filter, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=Open}"
                                     Command="{Binding SetFilterCommand}" CommandParameter="Open">
                            <TextBlock><Run Text="{local:T Aperti, Open}"/><Run Text="  "/><Run Text="{Binding OpenCount, Mode=OneWay}"/></TextBlock>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Tab}" GroupName="Filter"
                                     IsChecked="{Binding Filter, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=Ignored}"
                                     Command="{Binding SetFilterCommand}" CommandParameter="Ignored">
                            <TextBlock><Run Text="{local:T Ignorati, Ignored}"/><Run Text="  "/><Run Text="{Binding IgnoredCount, Mode=OneWay}"/></TextBlock>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Tab}" GroupName="Filter"
                                     IsChecked="{Binding Filter, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=Resolved}"
                                     Command="{Binding SetFilterCommand}" CommandParameter="Resolved">
                            <TextBlock><Run Text="{local:T Risolti, Solved}"/><Run Text="  "/><Run Text="{Binding ResolvedCount, Mode=OneWay}"/></TextBlock>
                        </RadioButton>
                    </StackPanel>
                </Grid>
            </Border>

        <!-- ══ HOME ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="3" Margin="28,16,10,0" Visibility="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Monitor}">
            <Grid.Resources>
                <Style x:Key="TileValue" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Level}" Value="medium"><Setter Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="high"><Setter Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger>
                    </Style.Triggers>
                </Style>
                <!-- Pin: in sight on the pointer or the keyboard, or when the value is pinned -->
                <Style x:Key="Pin" TargetType="Button" BasedOn="{StaticResource BtnSubtle}">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinHeight" Value="28"/>
                    <Setter Property="MinWidth" Value="28"/>
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="Content" Value="&#xE718;"/>
                    <Setter Property="FontFamily" Value="{DynamicResource Font.Icon}"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="ToolTip" Value="{local:T 'Tienilo tra i valori in evidenza', 'Keep it among the featured values'}"/>
                    <Setter Property="AutomationProperties.Name" Value="{local:T 'Fissa in evidenza', 'Pin to featured'}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Opacity" Value="1"/></Trigger>
                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                            <Setter Property="Opacity" Value="1"/>
                            <Setter Property="Content" Value="&#xE77A;"/>
                            <Setter Property="ToolTip" Value="{local:T 'Toglilo dai valori in evidenza', 'Remove it from the featured values'}"/>
                            <Setter Property="AutomationProperties.Name" Value="{local:T 'Togli dai valori in evidenza', 'Unpin from featured'}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
                <DataTemplate x:Key="TileTemplate">
                    <Border Style="{StaticResource Card}" Width="232" Height="124" Margin="0,0,10,10" Padding="14,10,8,10"
                            ToolTip="{Binding KeyHint}" AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.HelpText="{Binding KeyHint}"
                            Focusable="False">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding Label}" Style="{StaticResource Caps}" TextTrimming="CharacterEllipsis" Margin="0,4,34,0"/>
                            <Button Style="{StaticResource Pin}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Command="{Binding DataContext.TogglePinCommand, ElementName=HomeScroll}" CommandParameter="{Binding}"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Style="{StaticResource TileValue}">
                                    <Run Text="{Binding ValueText, Mode=OneWay}" FontFamily="{DynamicResource Font.Display}" FontSize="28" FontWeight="SemiBold"/>
                                    <Run Text="{Binding Unit, Mode=OneWay}" FontSize="13" Foreground="{DynamicResource Text.Secondary}"/>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="10,0,0,4" VerticalAlignment="Bottom" Visibility="{Binding IsStrained, Converter={StaticResource Vis}}">
                                    <TextBlock Style="{StaticResource LevelIcon}" Tag="{Binding Level}" FontSize="12"/>
                                    <TextBlock Text="{Binding LevelWord}" Style="{StaticResource LevelText}" Tag="{Binding Level}" Margin="5,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <local:Sparkline Grid.Row="2" Values="{Binding History}" Stroke="{DynamicResource Text.Secondary}" Margin="0,4,6,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
                <!-- The same tile among the featured ones: the group is named, since the tile stands alone -->
                <DataTemplate x:Key="FeaturedTemplate">
                    <Border Style="{StaticResource Card}" Width="232" Height="124" Margin="0,0,10,10" Padding="14,10,8,10"
                            ToolTip="{Binding KeyHint}" AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.HelpText="{Binding KeyHint}"
                            Focusable="False">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding FullLabel}" Style="{StaticResource Caps}" TextTrimming="CharacterEllipsis" Margin="0,4,34,0"/>
                            <Button Style="{StaticResource Pin}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Command="{Binding DataContext.TogglePinCommand, ElementName=HomeScroll}" CommandParameter="{Binding}"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Style="{StaticResource TileValue}">
                                    <Run Text="{Binding ValueText, Mode=OneWay}" FontFamily="{DynamicResource Font.Display}" FontSize="28" FontWeight="SemiBold"/>
                                    <Run Text="{Binding Unit, Mode=OneWay}" FontSize="13" Foreground="{DynamicResource Text.Secondary}"/>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="10,0,0,4" VerticalAlignment="Bottom" Visibility="{Binding IsStrained, Converter={StaticResource Vis}}">
                                    <TextBlock Style="{StaticResource LevelIcon}" Tag="{Binding Level}" FontSize="12"/>
                                    <TextBlock Text="{Binding LevelWord}" Style="{StaticResource LevelText}" Tag="{Binding Level}" Margin="5,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <local:Sparkline Grid.Row="2" Values="{Binding History}" Stroke="{DynamicResource Text.Secondary}" Margin="0,4,6,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </Grid.Resources>
            <ScrollViewer x:Name="HomeScroll" Padding="0,0,18,0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,24">
                    <!-- How it is going, in one line, and the one button that matters -->
                    <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LevelIcon}" Tag="{Binding StatusLevel}" FontSize="24" Margin="0,0,16,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Headline}" FontFamily="{DynamicResource Font.Display}" FontSize="20" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
                                <TextBlock Text="{Binding Subline}" Style="{StaticResource Secondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource BtnPrimary}" VerticalAlignment="Center" Margin="16,0,0,0"
                                    Content="{Binding CheckLabel}" Command="{Binding CheckNowCommand}"
                                    ToolTip="{local:T 'Ricontrolla tutto adesso (F5)', 'Check everything again now (F5)'}"/>
                        </Grid>
                    </Border>

                    <!-- The few problems that matter most -->
                    <StackPanel Visibility="{Binding TopProblems.Count, Converter={StaticResource Vis}}" Margin="0,0,0,10">
                        <TextBlock Text="{local:T 'Da sistemare', 'To fix'}" Style="{StaticResource SectionHead}"/>
                        <ItemsControl x:Name="TopList" ItemsSource="{Binding TopProblems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8" AutomationProperties.Name="{Binding AccessibleName}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource LevelIcon}" Tag="{Binding Level}" Margin="0,2,12,0" VerticalAlignment="Top"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Style="{StaticResource Secondary}" FontSize="12.5" Margin="0,2,0,0">
                                                    <Run Text="{Binding SeverityLabel, Mode=OneWay, Converter={StaticResource Sentence}}"/><Run Text=" · "/><Run Text="{Binding DetailShort, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource BtnGhost}" Content="{Binding FixLabel}" VerticalAlignment="Center" Margin="12,0,0,0"
                                                    Command="{Binding DataContext.FixCommand, ElementName=TopList}" CommandParameter="{Binding}"
                                                    Visibility="{Binding HasFix, Converter={StaticResource Vis}}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource BtnSubtle}" HorizontalAlignment="Left" Margin="-8,0,0,0" Command="{Binding ShowProblemsCommand}" CommandParameter="Open">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding MoreProblemsText}"/>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="11" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- What is running now -->
                    <StackPanel Visibility="{Binding RunningCount, Converter={StaticResource Vis}}" Margin="0,0,0,10">
                        <TextBlock Text="{local:T 'In corso', 'Running'}" Style="{StaticResource SectionHead}"/>
                        <ItemsControl ItemsSource="{Binding Running}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Step}" Style="{StaticResource Secondary}" Visibility="{Binding HasStep, Converter={StaticResource Vis}}"/>
                                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}" Margin="0,6,0,2" MaxWidth="480" HorizontalAlignment="Stretch"
                                                         Visibility="{Binding HasFraction, Converter={StaticResource Vis}}" AutomationProperties.Name="{Binding Title}"/>
                                            <TextBlock Text="{Binding When}" Style="{StaticResource Secondary}" FontSize="12.5"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock Text="{Binding MonitorEmptyText}" Style="{StaticResource Secondary}" Visibility="{Binding MonitorEmptyText, Converter={StaticResource Vis}}"/>
                    <!-- Values this PC cannot read, with why and the button that helps -->
                    <ItemsControl ItemsSource="{Binding MonitorNotices}" Focusable="False" Margin="0,0,0,6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,18,8" Padding="12,9" CornerRadius="{DynamicResource Radius.Control}" BorderThickness="1" BorderBrush="{DynamicResource Outline.Strong}"
                                        Background="{DynamicResource Surface.Overlay}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource LevelIcon}" Tag="medium" Margin="0,2,10,0" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                                                <Run Text="{Binding Values, Mode=OneWay}"/><Run Text="{local:T ': non disponibile', ': not available'}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Why}" TextWrapping="Wrap" Style="{StaticResource Secondary}"/>
                                            <TextBlock Text="{Binding Result}" TextWrapping="Wrap" Style="{StaticResource Secondary}" FontSize="12.5"
                                                       Visibility="{Binding Result, Converter={StaticResource Vis}}" AutomationProperties.LiveSetting="Polite"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="{Binding ButtonText}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                Command="{Binding DataContext.MonitorNoticeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                Visibility="{Binding HasFix, Converter={StaticResource Vis}}"
                                                AutomationProperties.Name="{Binding ButtonText}" AutomationProperties.HelpText="{Binding Why}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- At a glance: the values the person pinned, or else the ones under most strain right now -->
                    <TextBlock Text="{Binding FeaturedTitle, Converter={StaticResource Sentence}}" Style="{StaticResource SectionHead}"
                               Visibility="{Binding FeaturedTitle, Converter={StaticResource Vis}}"/>
                    <ItemsControl ItemsSource="{Binding Featured}" ItemTemplate="{StaticResource FeaturedTemplate}" Margin="0,0,0,8" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding MonitorGroups}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionHead}"/>
                                    <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource TileTemplate}" Focusable="False">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ══ PROBLEMS ═══════════════════════════════════════════════════ -->
        <Grid Grid.Row="3" Margin="28,14,10,0" Visibility="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Problems}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- What the last "put it right" button did -->
            <Border Margin="0,0,18,8" Padding="12,9" CornerRadius="{DynamicResource Radius.Control}" BorderThickness="1" BorderBrush="{DynamicResource Outline.Strong}"
                    Background="{DynamicResource Surface.Overlay}" Visibility="{Binding Notice, Converter={StaticResource Vis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource LevelIcon}" Margin="0,0,10,0">
                        <TextBlock.Tag>
                            <Binding Path="NoticeIsError" Converter="{StaticResource NoticeLevel}"/>
                        </TextBlock.Tag>
                    </TextBlock>
                    <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>
            <TextBlock Grid.Row="1" Text="{Binding EmptyText}" Style="{StaticResource Secondary}" Margin="0,8,0,0"
                       Visibility="{Binding EmptyText, Converter={StaticResource Vis}}"/>
            <ScrollViewer Grid.Row="1" Padding="0,0,18,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="FindingsList" ItemsSource="{Binding FindingSections}" Margin="0,0,0,24" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="{Binding Header, Converter={StaticResource Sentence}}" Style="{StaticResource SectionHead}"/>
                                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,14" AutomationProperties.Name="{Binding AccessibleName}">
                                                <!-- Right click: the same "More" actions -->
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="{local:T Copia, Copy}" Tag="&#xE8C8;" Command="{Binding PlacementTarget.Tag.CopyFindingCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="{local:T Ignora, Ignore}" Tag="&#xE7B3;" Command="{Binding PlacementTarget.Tag.IgnoreCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"
                                                                  Visibility="{Binding IsOpen, Converter={StaticResource Vis}}"/>
                                                        <MenuItem Header="{local:T Riapri, Reopen}" Tag="&#xE72C;" Command="{Binding PlacementTarget.Tag.ReopenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"
                                                                  Visibility="{Binding IsIgnored, Converter={StaticResource Vis}}"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Border.Tag>
                                                    <Binding Path="DataContext" ElementName="FindingsList"/>
                                                </Border.Tag>
                                                <!-- The buttons beside the text, or under it when the page is narrow -->
                                                <local:SideOrBelow MinMain="320" BelowIndent="32">
                                                    <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource LevelIcon}" Tag="{Binding Level}" FontSize="18" Margin="0,2,14,0" VerticalAlignment="Top"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding SeverityLabel, Converter={StaticResource Sentence}}" Style="{StaticResource LevelText}" Tag="{Binding Level}"/>
                                                        <!-- What happened (title), what it means (first sentence, the rest on request), what to do -->
                                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,4"/>
                                                        <TextBlock Text="{Binding DetailShort}" Style="{StaticResource Secondary}"
                                                                   Visibility="{Binding ShowDetail, Converter={StaticResource Vis}, ConverterParameter=not}"/>
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}"
                                                                   Visibility="{Binding ShowDetail, Converter={StaticResource Vis}}"/>
                                                        <Button Style="{StaticResource BtnSubtle}" Command="{Binding ToggleDetailCommand}" HorizontalAlignment="Left" Margin="-8,2,0,0"
                                                                Visibility="{Binding HasMore, Converter={StaticResource Vis}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock FontSize="12.5" Foreground="{DynamicResource Text.Secondary}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="{local:T 'Dettagli', 'Details'}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ShowDetail}" Value="True">
                                                                                    <Setter Property="Text" Value="{local:T 'Meno dettagli', 'Fewer details'}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock FontSize="10" Margin="6,0,0,0" Foreground="{DynamicResource Text.Secondary}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                                            <Setter Property="Text" Value="&#xE70D;"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ShowDetail}" Value="True"><Setter Property="Text" Value="&#xE70E;"/></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Button>
                                                        <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="0,6,0,0" Visibility="{Binding HasAdvice, Converter={StaticResource Vis}}">
                                                            <Run Text="{local:T 'Cosa fare: ', 'What to do: '}" FontWeight="SemiBold"/><Run Text="{Binding Advice, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Footer}" Style="{StaticResource Secondary}" FontSize="12" Margin="0,8,0,0" Foreground="{DynamicResource Text.Muted}"/>
                                                    </StackPanel>
                                                    </Grid>
                                                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" MinWidth="120">
                                                        <Button Style="{StaticResource BtnPrimary}" Content="{Binding FixLabel}" Margin="0,0,0,8"
                                                                ToolTip="{local:T 'OptLife lo sistema per te; resta scritto nel registro delle azioni', 'OptLife fixes it for you; it stays written in the action log'}"
                                                                Command="{Binding DataContext.FixCommand, ElementName=FindingsList}" CommandParameter="{Binding}"
                                                                Visibility="{Binding HasFix, Converter={StaticResource Vis}}"/>
                                                        <Button Style="{StaticResource BtnGhost}" Content="{local:T Risolto, Solved}" Margin="0,0,0,8"
                                                                ToolTip="{local:T 'La causa è sistemata: si chiude adesso e si riapre solo se succede di nuovo', 'The cause is fixed: it closes now and reopens only if it happens again'}"
                                                                AutomationProperties.HelpText="{local:T 'La causa è sistemata: si chiude adesso e si riapre solo se succede di nuovo', 'The cause is fixed: it closes now and reopens only if it happens again'}"
                                                                Command="{Binding DataContext.SolveCommand, ElementName=FindingsList}" CommandParameter="{Binding}"
                                                                Visibility="{Binding CanSolve, Converter={StaticResource Vis}}"/>
                                                        <Button Style="{StaticResource BtnGhost}" Content="{local:T Riapri, Reopen}" Margin="0,0,0,8"
                                                                Command="{Binding DataContext.ReopenCommand, ElementName=FindingsList}" CommandParameter="{Binding}"
                                                                Visibility="{Binding IsIgnored, Converter={StaticResource Vis}}"/>
                                                        <!-- More: what is seldom needed, in a menu (also with a right click) -->
                                                        <Button Style="{StaticResource BtnSubtle}" HorizontalAlignment="Right" Click="MoreButton_Click"
                                                                ToolTip="{local:T 'Altro: ignora, copia', 'More: ignore, copy'}" AutomationProperties.Name="{local:T 'Altre azioni', 'More actions'}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE712;" FontSize="14"/>
                                                                <TextBlock Text="{local:T Altro, More}" Margin="8,0,0,0" FontSize="13"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </local:SideOrBelow>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ══ RECORDED EVENTS ════════════════════════════════════════════ -->
        <Grid Grid.Row="3" Margin="28,14,10,0" Visibility="{Binding Page, Converter={StaticResource Is}, ConverterParameter=History}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <local:SideOrBelow Margin="0,0,18,0" MinMain="300">
                <WrapPanel VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource Segment}" GroupName="Days" Content="{local:T 24 ore, 24 hours}"
                                 IsChecked="{Binding HistoryDays, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=1}"
                                 Command="{Binding SetHistoryDaysCommand}" CommandParameter="1"/>
                    <RadioButton Style="{StaticResource Segment}" GroupName="Days" Content="{local:T 7 giorni, 7 days}"
                                 IsChecked="{Binding HistoryDays, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=7}"
                                 Command="{Binding SetHistoryDaysCommand}" CommandParameter="7"/>
                    <RadioButton Style="{StaticResource Segment}" GroupName="Days" Content="{local:T 30 giorni, 30 days}"
                                 IsChecked="{Binding HistoryDays, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=30}"
                                 Command="{Binding SetHistoryDaysCommand}" CommandParameter="30"/>
                    <TextBlock Text="{Binding HistorySummary}" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </WrapPanel>
                <Grid Width="280" HorizontalAlignment="Left">
                    <TextBox x:Name="HistorySearchBox" Style="{StaticResource Field}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{local:T 'Cerca negli eventi', 'Search the events'}"/>
                    <TextBlock Text="{local:T 'Cerca: programma, tipo, codice…', 'Search: program, type, code…'}" Foreground="{DynamicResource Text.Secondary}" FontSize="13"
                               IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0"
                               Visibility="{Binding Search, Converter={StaticResource Vis}, ConverterParameter=not}"/>
                </Grid>
            </local:SideOrBelow>
            <ListBox Grid.Row="1" Margin="0,14,0,0" Padding="0,0,18,0" ItemsSource="{Binding Events}"
                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     AutomationProperties.Name="{local:T 'Eventi registrati', 'Recorded events'}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                        <Setter Property="AutomationProperties.Name">
                            <Setter.Value>
                                <MultiBinding StringFormat="{}{0} {1}: {2}">
                                    <Binding Path="Time"/>
                                    <Binding Path="LevelWord"/>
                                    <Binding Path="Title"/>
                                </MultiBinding>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Outline.Subtle}" Padding="0,9,8,9" Background="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="104"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LevelIcon}" Tag="{Binding Level}" ToolTip="{Binding LevelWord, Converter={StaticResource Sentence}}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Time}" FontSize="12.5" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Title}"/>
                            <TextBlock Grid.Column="3" Text="{Binding Source}" Style="{StaticResource Secondary}" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- ══ ACTIONS TAKEN ══════════════════════════════════════════════ -->
        <Grid Grid.Row="3" Margin="28,14,10,0" Visibility="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Actions}">
            <TextBlock Text="{Binding ActionLogEmptyText}" Style="{StaticResource Secondary}" Visibility="{Binding ActionLogEmptyText, Converter={StaticResource Vis}}"/>
            <ScrollViewer Padding="0,0,18,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ActionLog}" Margin="0,0,0,24">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Outline.Subtle}" Padding="0,11,0,11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource LevelIcon}" Tag="{Binding Level}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Time}" FontSize="12.5" Foreground="{DynamicResource Text.Secondary}" Margin="0,2,0,0"/>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" Margin="0,2,0,0"/>
                                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource Text.Secondary}" Visibility="{Binding HasUndo, Converter={StaticResource Vis}}">
                                            <Run Text="{local:T 'Per tornare indietro: ', 'To undo: '}"/><Run Text="{Binding Undo, Mode=OneWay}" FontFamily="{DynamicResource Font.Mono}" FontSize="12"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="16,2,0,0">
                                        <TextBlock Text="{Binding Outcome, Converter={StaticResource Sentence}}" Style="{StaticResource LevelText}" Tag="{Binding Level}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding Source}" Style="{StaticResource Secondary}" FontSize="12" Margin="0,3,0,0" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ══ ACTIVITY ═══════════════════════════════════════════════════ -->
        <Grid Grid.Row="3" Margin="28,14,10,0" Visibility="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Activity}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Style="{StaticResource BtnSubtle}" Margin="-8,0,0,0" Command="{Binding ShowCommand}" CommandParameter="Modules">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEA8F;" FontSize="14"/>
                        <TextBlock Text="{local:T 'Avvisi e suono: in Impostazioni', 'Notices and sound: in Settings'}" Margin="8,0,0,0" FontSize="13"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Grid.Row="1" Text="{Binding ActivityEmptyText}" Style="{StaticResource Secondary}" Visibility="{Binding ActivityEmptyText, Converter={StaticResource Vis}}"/>
            <ScrollViewer Grid.Row="1" Padding="0,0,18,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Activities}" Margin="0,0,0,24">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Outline.Subtle}" Padding="0,11,0,11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource LevelIcon}" Tag="{Binding Level}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Step}" Margin="0,3,0,0" TextWrapping="Wrap" Visibility="{Binding HasStep, Converter={StaticResource Vis}}"/>
                                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}" Margin="0,6,0,2" Width="420" HorizontalAlignment="Left"
                                                     Visibility="{Binding HasFraction, Converter={StaticResource Vis}}" AutomationProperties.Name="{Binding Title}"/>
                                        <TextBlock Text="{Binding When}" Style="{StaticResource Secondary}" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" Margin="0,3,0,0" Visibility="{Binding HasDetail, Converter={StaticResource Vis}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="16,2,0,0">
                                        <TextBlock Text="{Binding Outcome, Converter={StaticResource Sentence}}" Style="{StaticResource LevelText}" Tag="{Binding Level}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding Source}" Style="{StaticResource Secondary}" FontSize="12" Margin="0,3,0,0" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ══ A MODULE'S OWN PAGE ════════════════════════════════════════ -->
        <Grid Grid.Row="3" Margin="28,14,10,0" DataContext="{Binding SelectedView}"
              Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Is}, ConverterParameter=View}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Buttons: what the last one did, the list to tick when one asks for it, then the buttons themselves -->
            <ScrollViewer x:Name="ButtonsPage" Grid.RowSpan="2" Padding="0,0,18,0" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding UsesButtonsPage, Converter={StaticResource Vis}}">
                <StackPanel Margin="0,0,0,24">
                    <Border Margin="0,0,0,14" Padding="12,9" CornerRadius="{DynamicResource Radius.Control}" BorderThickness="1" BorderBrush="{DynamicResource Outline.Strong}"
                            Background="{DynamicResource Surface.Overlay}" Visibility="{Binding Notice, Converter={StaticResource Vis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource LevelIcon}" Margin="0,0,10,0">
                                <TextBlock.Tag>
                                    <Binding Path="NoticeIsError" Converter="{StaticResource NoticeLevel}"/>
                                </TextBlock.Tag>
                            </TextBlock>
                            <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,18" Padding="18,16" Visibility="{Binding HasChoices, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ChoicesTitle}" Style="{StaticResource Subtitle}" FontSize="17"/>
                            <TextBlock Text="{Binding ChoicesHint}" Style="{StaticResource Secondary}" Margin="0,4,0,12"/>
                            <!-- One heading per category, with a box that ticks the whole category; programs as small cards with their icon -->
                            <ItemsControl ItemsSource="{Binding ChoiceGroups}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4,0,10">
                                            <CheckBox Style="{StaticResource Tick}" IsThreeState="False" IsChecked="{Binding AllChecked}" Margin="0,0,0,8"
                                                      Visibility="{Binding HasName, Converter={StaticResource Vis}}" AutomationProperties.Name="{Binding Header}">
                                                <TextBlock Text="{Binding Header, Converter={StaticResource Sentence}}" Style="{StaticResource Caps}" FontSize="13"/>
                                            </CheckBox>
                                            <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Style="{StaticResource ChoiceCard}" IsChecked="{Binding IsChecked}" ToolTip="{Binding Detail}"
                                                                  AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Detail}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Grid Width="28" Height="28" VerticalAlignment="Center">
                                                                    <Border Background="{DynamicResource Surface.Overlay}" CornerRadius="4" BorderBrush="{DynamicResource Outline.Subtle}" BorderThickness="1">
                                                                        <TextBlock Text="{Binding Monogram}" FontSize="14" FontWeight="SemiBold"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}"/>
                                                                    </Border>
                                                                    <Image Source="{Binding Icon, Converter={StaticResource FileIcon}}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                </Grid>
                                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Style="{StaticResource BtnPrimary}" Content="{Binding ChoicesConfirm}"
                                        Command="{Binding DataContext.ConfirmChoicesCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <Button Style="{StaticResource BtnGhost}" Content="{local:T Annulla, Cancel}" Margin="10,0,0,0"
                                        Command="{Binding DataContext.CancelChoicesCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding ButtonGroups}" Focusable="False" Visibility="{Binding IsGallery, Converter={StaticResource Vis}, ConverterParameter=not}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4,0,14">
                                    <TextBlock Text="{Binding Name, Converter={StaticResource Sentence}}" Style="{StaticResource SectionHead}"/>
                                    <ItemsControl ItemsSource="{Binding Buttons}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Card}" Padding="16,10" Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Margin="0,0,16,0">
                                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" FontSize="12.5" Margin="0,2,0,0"
                                                                       Visibility="{Binding HasDescription, Converter={StaticResource Vis}}"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="{Binding ButtonText}" VerticalAlignment="Center"
                                                                AutomationProperties.HelpText="{Binding Label}"
                                                                Command="{Binding DataContext.PressCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Checklist: summary, how to order it, then the lines -->
                    <StackPanel Visibility="{Binding IsChecklist, Converter={StaticResource Vis}}">
                        <local:SideOrBelow Margin="0,0,0,14" MinMain="360">
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource LevelIcon}" Tag="{Binding CheckLevel}" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding CheckSummary}" FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                            </WrapPanel>
                            <WrapPanel VerticalAlignment="Center" Visibility="{Binding CanSortChecks, Converter={StaticResource Vis}}">
                                <TextBlock Text="{local:T 'Ordina per', 'Order by'}" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="CheckSort" Content="{local:T Predefinito, Default}"
                                             IsChecked="{Binding CheckSort, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=order}"
                                             Command="{Binding SortChecksCommand}" CommandParameter="order"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="CheckSort" Content="{local:T Categoria, Category}"
                                             IsChecked="{Binding CheckSort, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=kind}"
                                             Command="{Binding SortChecksCommand}" CommandParameter="kind"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="CheckSort" Content="{local:T Importanza, Importance}"
                                             IsChecked="{Binding CheckSort, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=importance}"
                                             Command="{Binding SortChecksCommand}" CommandParameter="importance"/>
                            </WrapPanel>
                        </local:SideOrBelow>
                        <ItemsControl ItemsSource="{Binding CheckGroups}" Margin="0,0,0,24" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="6,4,6,4">
                                        <StackPanel>
                                            <!-- The heading opens and closes its lines -->
                                            <Button Style="{StaticResource Bare}" Command="{Binding ToggleCommand}" Padding="0" AutomationProperties.Name="{Binding AccessibleName}">
                                                <Border Padding="10,10" Background="Transparent">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource LevelIcon}" Tag="{Binding Level}" Margin="0,0,10,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Summary}" Style="{StaticResource Secondary}" FontSize="12.5" Margin="14,0,0,0"
                                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center"
                                                                   Visibility="{Binding IsExpanded, Converter={StaticResource Vis}, ConverterParameter=not}"/>
                                                        <TextBlock Grid.Column="3" FontSize="11" Margin="12,0,0,0" Foreground="{DynamicResource Text.Secondary}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                                    <Setter Property="Text" Value="&#xE70D;"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Text" Value="&#xE70E;"/></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </Button>
                                            <ItemsControl ItemsSource="{Binding Rows}" Visibility="{Binding IsExpanded, Converter={StaticResource Vis}}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Outline.Subtle}" Padding="10,9" AutomationProperties.Name="{Binding AccessibleName}">
                                                            <!-- Name and value in two columns; state and buttons beside them, or under them when the page is narrow -->
                                                            <local:SideOrBelow MinMain="380" BelowIndent="26">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="230"/>
                                                                        <ColumnDefinition Width="3*" MinWidth="120"/>
                                                                    </Grid.ColumnDefinitions>
                                                                <TextBlock Style="{StaticResource LevelIcon}" Tag="{Binding Level}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="0,0,16,0" TextWrapping="Wrap" VerticalAlignment="Top"/>
                                                                <StackPanel Grid.Column="2" Margin="0,0,0,0">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding ValueHead}" Style="{StaticResource LevelValue}" Tag="{Binding ValueLevel}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                        <!-- The technical second line opens on request -->
                                                                        <Button Style="{StaticResource BtnSubtle}" MinHeight="22" MinWidth="22" Padding="4,0" Margin="6,-2,0,0" VerticalAlignment="Top"
                                                                                Command="{Binding ToggleCommand}" Visibility="{Binding HasMoreToggle, Converter={StaticResource Vis}}"
                                                                                ToolTip="{local:T 'Altri dettagli', 'More details'}" AutomationProperties.Name="{local:T 'Altri dettagli', 'More details'}">
                                                                            <TextBlock FontSize="10" Foreground="{DynamicResource Text.Secondary}">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                                                        <Setter Property="Text" Value="&#xE70D;"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Text" Value="&#xE70E;"/></DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </Button>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding ValueMore}" Style="{StaticResource Secondary}" FontSize="12.5" Margin="0,2,0,0"
                                                                               Visibility="{Binding ShowValueMore, Converter={StaticResource Vis}}"/>
                                                                    <TextBlock Text="{Binding Expected}" Style="{StaticResource Secondary}" FontSize="12.5" Margin="0,2,0,0"
                                                                               Visibility="{Binding HasExpected, Converter={StaticResource Vis}}"/>
                                                                    <TextBlock Text="{Binding Advice}" Style="{StaticResource Secondary}" FontSize="12.5" Margin="0,3,0,0"
                                                                               Visibility="{Binding HasAdvice, Converter={StaticResource Vis}}"/>
                                                                </StackPanel>
                                                                </Grid>
                                                                <WrapPanel VerticalAlignment="Top">
                                                                <TextBlock Style="{StaticResource LevelText}" Tag="{Binding Level}" Text="{Binding StatusLabel, Converter={StaticResource Sentence}}"
                                                                           VerticalAlignment="Top" Margin="0,2,0,0" Visibility="{Binding HasStatus, Converter={StaticResource Vis}}"/>
                                                                <ItemsControl ItemsSource="{Binding Buttons}" VerticalAlignment="Top" Margin="10,-4,0,0" Focusable="False"
                                                                              Visibility="{Binding HasButtons, Converter={StaticResource Vis}}">
                                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Button Style="{StaticResource BtnGhost}" Content="{Binding ButtonText}" Margin="6,0,0,4" AutomationProperties.HelpText="{Binding Label}"
                                                                                    Command="{Binding DataContext.PressCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                </WrapPanel>
                                                            </local:SideOrBelow>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <!-- Gallery: search, filter by group, then the cards of each group -->
                    <StackPanel Visibility="{Binding IsGallery, Converter={StaticResource Vis}}">
                        <local:SideOrBelow Margin="0,0,0,14" MinMain="300">
                            <Grid MaxWidth="360" HorizontalAlignment="Left">
                                <TextBox Style="{StaticResource Field}" Text="{Binding GallerySearch, UpdateSourceTrigger=PropertyChanged}" Padding="32,6,8,6" MinWidth="240"
                                         AutomationProperties.Name="{local:T 'Cerca in questa pagina', 'Search this page'}"/>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="14" Margin="11,0,0,0" IsHitTestVisible="False" Foreground="{DynamicResource Text.Secondary}"/>
                                <TextBlock Text="{local:T 'Cerca un titolo', 'Search a title'}" Margin="33,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                           FontSize="13" Foreground="{DynamicResource Text.Secondary}"
                                           Visibility="{Binding GallerySearch, Converter={StaticResource Vis}, ConverterParameter=not}"/>
                            </Grid>
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding GalleryCount}" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,14,0" AutomationProperties.LiveSetting="Polite"/>
                                <Button Style="{StaticResource BtnGhost}" Margin="0,0,10,0"
                                        ToolTip="{local:T 'Copertine grandi, da usare col controller dal divano (B per uscire)', 'Big covers, to use with a controller from the sofa (B to exit)'}"
                                        Command="{Binding DataContext.BigLibraryCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" FontSize="13"/>
                                        <TextBlock Text="{local:T 'Schermo intero', 'Full screen'}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BtnGhost}" Margin="0,0,10,0" MinWidth="36" Padding="8,0" Click="GalleryPageMore_Click"
                                        ToolTip="{local:T 'Altre funzioni della pagina', 'More functions of the page'}" AutomationProperties.Name="{local:T 'Altre funzioni della pagina', 'More functions of the page'}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE712;" FontSize="14"/>
                                </Button>
                            </WrapPanel>
                        </local:SideOrBelow>
                        <!-- Order and filter: one grid of every game, as a store library; the launcher or console is a drop-down -->
                        <WrapPanel Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" Margin="0,0,24,6" Visibility="{Binding CanSortGallery, Converter={StaticResource Vis}}">
                                <TextBlock Text="{local:T 'Ordina per', 'Order by'}" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="GallerySort" Content="{local:T 'Aggiunti di recente', 'Recently added'}"
                                             IsChecked="{Binding GallerySort, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=added}"
                                             Command="{Binding SortGalleryCommand}" CommandParameter="added"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="GallerySort" Content="{local:T Nome, Name}"
                                             IsChecked="{Binding GallerySort, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=name}"
                                             Command="{Binding SortGalleryCommand}" CommandParameter="name"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="GallerySort" Content="{local:T 'Giocati di recente', 'Recently played'}"
                                             IsChecked="{Binding GallerySort, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=used}"
                                             Command="{Binding SortGalleryCommand}" CommandParameter="used"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6" Visibility="{Binding HasGalleryFilters, Converter={StaticResource Vis}}">
                                <TextBlock x:Name="GalleryShowLabel" Text="{local:T Mostra, Show}" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox Style="{StaticResource Pick}" MinWidth="200" ItemsSource="{Binding GalleryFilters}" DisplayMemberPath="Label"
                                          SelectedItem="{Binding GalleryFilterChoice}" AutomationProperties.LabeledBy="{Binding ElementName=GalleryShowLabel}"/>
                            </StackPanel>
                        </WrapPanel>
                        <ItemsControl ItemsSource="{Binding GallerySections}" Margin="0,0,0,24" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource SectionHead}" AutomationProperties.HeadingLevel="Level2" Visibility="{Binding Name, Converter={StaticResource Vis}}"/>
                                        <ItemsControl ItemsSource="{Binding Cards}" Focusable="False" AutomationProperties.Name="{Binding AccessibleName}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Card}" Width="196" Padding="8" Margin="0,0,12,12" ToolTip="{Binding Advice}"
                                                            AutomationProperties.Name="{Binding AccessibleName}">
                                                        <StackPanel>
                                                            <Border Height="236" CornerRadius="4" Background="{DynamicResource Surface.Overlay}" ClipToBounds="True">
                                                                <Grid>
                                                                    <!-- No picture: a card drawn with the title, readable -->
                                                                    <StackPanel VerticalAlignment="Center" Margin="14,0" Visibility="{Binding HasImage, Converter={StaticResource Vis}, ConverterParameter=not}">
                                                                        <TextBlock Text="{Binding Initial}" FontSize="44" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource Text.Secondary}"/>
                                                                        <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                                                    </StackPanel>
                                                                    <Image Source="{Binding Picture, Converter={StaticResource SoftImage}}" Stretch="UniformToFill" Opacity="0.55" RenderOptions.BitmapScalingMode="Linear"/>
                                                                    <Image Source="{Binding Picture, Converter={StaticResource FileImage}}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                                                                          />
                                                                </Grid>
                                                            </Border>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="2,8,2,0" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                                                            <StackPanel Orientation="Horizontal" Margin="2,2,2,0">
                                                                <TextBlock Style="{StaticResource LevelIcon}" Tag="{Binding Level}" FontSize="11" Margin="0,1,6,0" VerticalAlignment="Top"
                                                                           Visibility="{Binding Warns, Converter={StaticResource Vis}}"/>
                                                                <TextBlock Text="{Binding Line}" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" MaxWidth="170"/>
                                                            </StackPanel>
                                                            <Grid Margin="0,8,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Button Style="{StaticResource BtnPrimary}" Content="{Binding Primary.ButtonText}" HorizontalAlignment="Stretch"
                                                                        AutomationProperties.Name="{Binding PrimaryName}" Visibility="{Binding HasPrimary, Converter={StaticResource Vis}}"
                                                                        Command="{Binding DataContext.PressCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Primary}"/>
                                                                <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Margin="6,0,0,0" MinWidth="36" Padding="8,0" Tag="{Binding}"
                                                                        Click="GalleryMore_Click" ToolTip="{Binding MoreName}" AutomationProperties.Name="{Binding MoreName}"
                                                                        Visibility="{Binding HasMore, Converter={StaticResource Vis}}">
                                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE712;" FontSize="14"/>
                                                                </Button>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- A form: the live picture of the module's settings (draggable), then the settings and Save -->
            <ScrollViewer Grid.RowSpan="2" Padding="0,0,18,0" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsForm, Converter={StaticResource Vis}}">
                <StackPanel Margin="0,0,0,24">
                    <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,14" Visibility="{Binding HasPreview, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <!-- The screen in small, with the overlay where it would be. Arrows move it too (Shift: faster). -->
                            <Border x:Name="PreviewScreen" Height="300" CornerRadius="6" ClipToBounds="True" Focusable="True"
                                    FocusVisualStyle="{StaticResource FocusRing}" KeyDown="PreviewScreen_KeyDown"
                                    AutomationProperties.Name="{Binding PreviewText}"
                                    AutomationProperties.HelpText="{local:T 'Anteprima dell\'overlay: con le frecce la sposti, con Maiusc più in fretta', 'Overlay preview: the arrows move it, with Shift faster'}">
                                <Viewbox Stretch="Uniform">
                                    <Canvas x:Name="PreviewCanvas" Width="{Binding ScreenWidth}" Height="{Binding ScreenHeight}" ClipToBounds="True">
                                        <!-- A game scene in small: dark at the top, bright at the bottom, to judge the text on both -->
                                        <Rectangle Width="{Binding ScreenWidth}" Height="{Binding ScreenHeight}">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
                                                    <GradientStop Color="#1B2433" Offset="0"/>
                                                    <GradientStop Color="#36506E" Offset="0.45"/>
                                                    <GradientStop Color="#C9B48A" Offset="0.8"/>
                                                    <GradientStop Color="#E8E2D2" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <Image Source="{Binding PreviewPng, Converter={StaticResource PngImage}}" Stretch="None"
                                               Canvas.Left="{Binding PreviewLeft}" Canvas.Top="{Binding PreviewTop}" Cursor="SizeAll"
                                               MouseLeftButtonDown="PreviewImage_MouseDown" MouseMove="PreviewImage_MouseMove" MouseLeftButtonUp="PreviewImage_MouseUp"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <!-- A chosen value this PC cannot read, and what would bring it (the processor temperature without Afterburner) -->
                            <Border Margin="0,10,0,0" Padding="12,9" CornerRadius="{DynamicResource Radius.Control}" BorderThickness="1" BorderBrush="{DynamicResource Outline.Strong}"
                                    Background="{DynamicResource Surface.Overlay}" Visibility="{Binding PreviewNotice, Converter={StaticResource Vis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource LevelIcon}" Tag="medium" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                    <TextBlock Text="{Binding PreviewNotice}" TextWrapping="Wrap" MaxWidth="760" AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Secondary}" FontSize="12.5" Margin="2,8,0,0"
                                       Text="{local:T 'Trascina la striscia dove la vuoi (o selezionala e usa le frecce). I valori sono quelli di adesso; quelli che ci sono solo in gioco hanno un trattino. Salva in fondo per vederla così nel gioco.', 'Drag the strip where you want it (or select it and use the arrows). The values are the current ones; those that exist only in a game show a dash. Save at the bottom to see it like this in the game.'}"/>
                            <!-- The same picture at its true size, on dark and on bright, to judge colours and text -->
                            <TextBlock Text="{local:T 'A grandezza vera', 'At its true size'}" Style="{StaticResource Caps}" Margin="2,12,0,6"/>
                            <Border HorizontalAlignment="Left" CornerRadius="4" ClipToBounds="True" Padding="14">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#1B2433" Offset="0"/>
                                        <GradientStop Color="#36506E" Offset="0.4"/>
                                        <GradientStop Color="#E8E2D2" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Image Source="{Binding PreviewPng, Converter={StaticResource PngImage}}" Stretch="None" AutomationProperties.Name="{Binding PreviewText}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding PreviewText}" Style="{StaticResource Secondary}" Visibility="{Binding HasPreview, Converter={StaticResource Vis}, ConverterParameter=not}"/>
                    <!-- Advanced: every setting and the whole tables; off, only what most people change -->
                    <Grid Margin="0,14,0,0" Visibility="{Binding Form.HasAdvanced, Converter={StaticResource Vis}}">
                        <StackPanel Margin="0,0,120,0">
                            <TextBlock x:Name="AdvancedLabel" Text="{local:T Avanzate, Advanced}" FontWeight="SemiBold"/>
                            <TextBlock Text="{local:T 'Mostra tutte le impostazioni e le tabelle complete (etichette, limiti, colori, profili, pixel).', 'Shows every setting and the full tables (labels, limits, colours, profiles, pixels).'}" Style="{StaticResource Secondary}" FontSize="12.5"/>
                        </StackPanel>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Form.ShowAdvanced}" HorizontalAlignment="Right" VerticalAlignment="Top" AutomationProperties.LabeledBy="{Binding ElementName=AdvancedLabel}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Form.Settings}" Focusable="False" ItemTemplate="{StaticResource SettingRow}"/>
                    <ContentControl Content="{Binding Form}" ContentTemplate="{StaticResource ModuleSaveRow}" Focusable="False"/>
                </StackPanel>
            </ScrollViewer>


            <!-- A table: the module's events, one per line -->
            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Outline.Strong}" Padding="0,0,0,8" Margin="0,0,18,0"
                    Visibility="{Binding IsTable, Converter={StaticResource Vis}}">
                <ItemsControl ItemsSource="{Binding Header}" Focusable="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text, Converter={StaticResource Sentence}}" Width="{Binding Width}" TextAlignment="{Binding Align}" Style="{StaticResource Caps}" Margin="0,0,14,0"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <TextBlock Grid.Row="1" Text="{Binding EmptyText}" Style="{StaticResource Secondary}" Margin="0,14,0,0" Visibility="{Binding EmptyText, Converter={StaticResource Vis}}"/>
            <ScrollViewer Grid.Row="1" Padding="0,0,18,0" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsTable, Converter={StaticResource Vis}}">
                <ItemsControl ItemsSource="{Binding Rows}" Margin="0,0,0,24" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Outline.Subtle}" Padding="0,9,0,9">
                                <ItemsControl ItemsSource="{Binding}" Focusable="False">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" Width="{Binding Width}" TextAlignment="{Binding Align}" Margin="0,0,14,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ══ OVERVIEW of a side-bar entry: how its pages work together, one card per page ══ -->
        <ScrollViewer Grid.Row="3" Margin="28,14,10,0" Padding="0,0,18,0" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Intro}">
            <StackPanel Margin="0,0,0,24" MaxWidth="980" HorizontalAlignment="Left">
                <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
                    <TextBlock Text="{Binding IntroText}" TextWrapping="Wrap" LineHeight="22"/>
                </Border>
                <ItemsControl ItemsSource="{Binding IntroCards}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,10" AutomationProperties.Name="{Binding Title}">
                                <local:SideOrBelow MinMain="320" BelowIndent="34">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource LevelIcon}" Tag="{Binding Level}" FontSize="18" Margin="0,2,14,0" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"/>
                                            <TextBlock Text="{Binding Guide}" Style="{StaticResource Secondary}" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding Summary}" Margin="0,6,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                                                       Visibility="{Binding HasSummary, Converter={StaticResource Vis}}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Button Style="{StaticResource BtnGhost}" Content="{Binding OpenText}" Command="{Binding OpenCommand}" VerticalAlignment="Center"/>
                                </local:SideOrBelow>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>


        <!-- ══ REPORT ═════════════════════════════════════════════════════ -->
        <Grid Grid.Row="3" Margin="28,14,10,0" Visibility="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Report}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource Segment}" GroupName="ReportDays" Content="{local:T 7 giorni, 7 days}"
                             IsChecked="{Binding ReportDays, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=7}"
                             Command="{Binding SetReportDaysCommand}" CommandParameter="7"/>
                <RadioButton Style="{StaticResource Segment}" GroupName="ReportDays" Content="{local:T 30 giorni, 30 days}"
                             IsChecked="{Binding ReportDays, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=30}"
                             Command="{Binding SetReportDaysCommand}" CommandParameter="30"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" Margin="0,14,0,0" Padding="0,0,18,0" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <!-- The period in a few numbers, each with its word when it is worrying -->
                <ItemsControl ItemsSource="{Binding ReportFigures}" Focusable="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Width="176" Margin="0,0,8,10" Padding="14,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label, Converter={StaticResource Sentence}}" Style="{StaticResource Caps}" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding Value}" FontFamily="{DynamicResource Font.Display}" FontSize="30" FontWeight="SemiBold" Style="{StaticResource LevelValue}" Tag="{Binding Level}"/>
                                        <TextBlock Style="{StaticResource LevelIcon}" Tag="{Binding Level}" Margin="8,6,0,0" VerticalAlignment="Center">
                                            <TextBlock.Visibility>
                                                <Binding Path="Level" Converter="{StaticResource WorryVis}"/>
                                            </TextBlock.Visibility>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding ReportLines}" Margin="0,0,0,24" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text, Converter={StaticResource Sentence}}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                                        <Setter Property="Margin" Value="0,3,0,0"/>
                                        <Setter Property="LineHeight" Value="20"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                                                <Setter Property="FontSize" Value="16"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Margin" Value="0,20,0,6"/>
                                                <Setter Property="AutomationProperties.HeadingLevel" Value="Level2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ══ SETTINGS ═══════════════════════════════════════════════════ -->
        <ScrollViewer x:Name="SettingsScroll" Grid.Row="3" Margin="28,14,10,0" Padding="0,0,18,0" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Modules}">
          <StackPanel Margin="0,0,0,24">
            <!-- Appearance: the look of the panel, saved for this PC -->
            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{local:T 'Lingua e aspetto', 'Language and appearance'}" Style="{StaticResource Subtitle}" FontSize="17" AutomationProperties.HeadingLevel="Level2"/>
                    <TextBlock Text="{local:T 'Lo sfondo Windows segue il modo chiaro o scuro di Windows, con il suo materiale trasparente (Mica). Il colore di Windows segue Impostazioni di Windows → Personalizzazione → Colori.', 'The Windows background follows Windows light or dark mode, with its see-through material (Mica). The Windows colour follows Windows Settings → Personalisation → Colours.'}"
                               Style="{StaticResource Secondary}" Margin="0,4,0,0"/>
                    <TextBlock Text="{local:T Lingua, Language}" Style="{StaticResource Caps}" Margin="0,16,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <Button Style="{StaticResource SwatchChoice}" Tag="{Binding IsItalian}" Command="{Binding SetLanguageCommand}" CommandParameter="it" AutomationProperties.Name="Italiano">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Content="{StaticResource FlagIt}" Width="24" Height="16" Margin="0,0,8,0" Focusable="False"/>
                                <TextBlock Text="Italiano" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SwatchChoice}" Tag="{Binding IsEnglish}" Command="{Binding SetLanguageCommand}" CommandParameter="en" AutomationProperties.Name="English">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Content="{StaticResource FlagEn}" Width="24" Height="16" Margin="0,0,8,0" Focusable="False"/>
                                <TextBlock Text="English" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding OpenBigAtStart}" Margin="0,12,0,0"
                              AutomationProperties.Name="{local:T 'Apri il pannello nella libreria a schermo intero', 'Open the panel in the full-screen library'}">
                        <StackPanel>
                            <TextBlock Text="{local:T 'Apri il pannello nella libreria a schermo intero', 'Open the panel in the full-screen library'}"/>
                            <TextBlock Text="{local:T 'Per un PC usato dal divano: il pannello si apre sulle copertine da usare col controller; uscendo si torna al pannello normale.', 'For a PC used from the sofa: the panel opens on the covers to use with a controller; leaving it shows the normal panel.'}"
                                       Style="{StaticResource Secondary}" FontSize="12.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </CheckBox>
                    <TextBlock Text="{local:T Sfondo, Background}" Style="{StaticResource Caps}" Margin="0,10,0,8"/>
                    <ItemsControl x:Name="BaseList" ItemsSource="{Binding ThemeBases}" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SwatchChoice}" Tag="{Binding IsSelected}" AutomationProperties.Name="{Binding Name}"
                                        Command="{Binding DataContext.SetThemeBaseCommand, ElementName=BaseList}" CommandParameter="{Binding Id}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="16" Height="16" CornerRadius="4" Background="{Binding Swatch}" BorderBrush="{DynamicResource Outline.Strong}" BorderThickness="1" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{local:T 'Colore d\'accento', 'Accent colour'}" Style="{StaticResource Caps}" Margin="0,10,0,8"/>
                    <ItemsControl x:Name="AccentList" ItemsSource="{Binding ThemeAccents}" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SwatchChoice}" Tag="{Binding IsSelected}" AutomationProperties.Name="{Binding Name}"
                                        Command="{Binding DataContext.SetThemeAccentCommand, ElementName=AccentList}" CommandParameter="{Binding Id}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="16" Height="16" CornerRadius="8" Background="{Binding Swatch}" BorderBrush="{DynamicResource Outline.Strong}" BorderThickness="1" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding IsCustomAccent, Converter={StaticResource Vis}}">
                        <TextBlock Text="{local:T 'Il tuo colore', 'Your colour'}" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource Text.Secondary}"/>
                        <TextBox Style="{StaticResource Field}" Width="120" Text="{Binding CustomAccent, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{local:T 'Il tuo colore, come #3B82F6', 'Your colour, like #3B82F6'}"/>
                        <TextBlock Text="{Binding CustomAccentError}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource Warning}"/>
                    </StackPanel>
                    <TextBlock Text="{local:T 'Dimensione', 'Size'}" Style="{StaticResource Caps}" Margin="0,12,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource BtnGhost}" Width="40" Command="{Binding ZoomByCommand}" CommandParameter="-0.1"
                                AutomationProperties.Name="{local:T 'Più piccolo', 'Smaller'}" ToolTip="{local:T 'Più piccolo (Ctrl+meno)', 'Smaller (Ctrl+minus)'}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE738;" FontSize="12"/>
                        </Button>
                        <TextBlock Text="{Binding ZoomText}" VerticalAlignment="Center" Width="56" TextAlignment="Center"/>
                        <Button Style="{StaticResource BtnGhost}" Width="40" Command="{Binding ZoomByCommand}" CommandParameter="0.1"
                                AutomationProperties.Name="{local:T 'Più grande', 'Larger'}" ToolTip="{local:T 'Più grande (Ctrl+più)', 'Larger (Ctrl+plus)'}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12"/>
                        </Button>
                        <TextBlock Text="{local:T 'Si somma alla dimensione del testo scelta in Windows (Accessibilità → Dimensioni testo).', 'Adds to the text size chosen in Windows (Accessibility → Text size).'}"
                                   Style="{StaticResource Secondary}" FontSize="12.5" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                    <Button Style="{StaticResource BtnGhost}" HorizontalAlignment="Left" Margin="0,16,0,0" Command="{Binding StartTourCommand}"
                            ToolTip="{local:T 'Di nuovo la visita della prima volta: lingua, aspetto e le scelte consigliate, pagina per pagina', 'The first-time tour again: language, look and the suggested choices, page by page'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7C3;" FontSize="13"/>
                            <TextBlock Text="{local:T 'Rifai la visita guidata', 'Take the guided tour again'}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
            <!-- Notices: the agent's pop-up for activities, always silenceable from here -->
            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{local:T Avvisi, Notices}" Style="{StaticResource Subtitle}" FontSize="17" AutomationProperties.HeadingLevel="Level2"/>
                    <TextBlock Text="{local:T 'Il piccolo avviso di OptLife sopra l\'orologio quando una cosa lunga inizia o finisce (mai una notifica di Windows). Durante un gioco resta zitto e dice tutto a partita finita.', 'OptLife\'s small notice above the clock when something long starts or ends (never a Windows notification). During a game it stays quiet and says it all once the game is over.'}"
                               Style="{StaticResource Secondary}" Margin="0,4,0,12"/>
                    <Grid Margin="0,0,0,10">
                        <TextBlock x:Name="NotifyPopupLabel" Text="{local:T Avviso sopra l\'orologio, Notice above the clock}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding NotifyPopup}" HorizontalAlignment="Right" AutomationProperties.LabeledBy="{Binding ElementName=NotifyPopupLabel}"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <TextBlock x:Name="NotifySoundLabel" Text="{local:T Suono alla fine, Sound at the end}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding NotifySound}" HorizontalAlignment="Right" AutomationProperties.LabeledBy="{Binding ElementName=NotifySoundLabel}"/>
                    </Grid>
                    <Grid>
                        <TextBlock x:Name="NotifySchedulerLabel" Text="{local:T Anche per i lavori del Pianificatore partiti da soli, Also for Scheduler jobs that start by themselves}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding NotifyScheduler}" HorizontalAlignment="Right" AutomationProperties.LabeledBy="{Binding ElementName=NotifySchedulerLabel}"/>
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock Text="{local:T Moduli, Modules}" Style="{StaticResource SectionHead}" Margin="0,12,0,10"/>
            <ItemsControl x:Name="ModuleList" ItemsSource="{Binding Modules}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- The head opens and closes the card -->
                                    <Button Style="{StaticResource Bare}" Command="{Binding ToggleExpandedCommand}" AutomationProperties.Name="{Binding Name}"
                                            AutomationProperties.HelpText="{Binding Description}">
                                        <Grid Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="11" Margin="0,6,0,0" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Top">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                        <Setter Property="Text" Value="&#xE76C;"/>
                                                        <Setter Property="VerticalAlignment" Value="Top"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Text" Value="&#xE70D;"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" Margin="0,2,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,2">
                                                    <TextBlock Style="{StaticResource LevelIcon}" Tag="{Binding StatusLevel}" FontSize="12"/>
                                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Secondary}" FontSize="12.5" Margin="8,0,0,0"/>
                                                    <TextBlock Text="{Binding Contents, StringFormat='  ·  {0}'}" Style="{StaticResource Secondary}" FontSize="12.5" Foreground="{DynamicResource Text.Muted}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" VerticalAlignment="Top" Margin="16,2,0,0"
                                              ToolTip="{local:T Accendi o spegni questo modulo, Switch this module on or off}"
                                              AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{local:T Accendi o spegni questo modulo, Switch this module on or off}"/>
                                </Grid>

                                <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource Vis}}" Margin="26,0,0,0">
                                    <!-- Advanced: every setting and the whole tables; off, only what most people change -->
                                    <Grid Margin="0,14,0,0" Visibility="{Binding HasAdvanced, Converter={StaticResource Vis}}">
                                        <StackPanel Margin="0,0,120,0">
                                            <TextBlock x:Name="AdvancedLabel" Text="{local:T Avanzate, Advanced}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{local:T 'Mostra tutte le impostazioni e le tabelle complete (etichette, limiti, colori, profili, pixel).', 'Shows every setting and the full tables (labels, limits, colours, profiles, pixels).'}" Style="{StaticResource Secondary}" FontSize="12.5"/>
                                        </StackPanel>
                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowAdvanced}" HorizontalAlignment="Right" VerticalAlignment="Top" AutomationProperties.LabeledBy="{Binding ElementName=AdvancedLabel}"/>
                                    </Grid>
                                <!-- What this module may do to the PC, and whether it has to ask -->
                                <StackPanel Visibility="{Binding HasActions, Converter={StaticResource Vis}}">
                                    <Border Height="1" Background="{DynamicResource Outline.Subtle}" Margin="0,14,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <TextBlock Text="{local:T 'Cosa può fare', 'What it can do'}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <!-- The meaning of the three choices: on the pointer, and for the keyboard and screen readers in the help text -->
                                        <Border Margin="8,0,0,0" Background="Transparent" Focusable="True" FocusVisualStyle="{StaticResource FocusRing}" Cursor="Help"
                                                ToolTipService.ShowDuration="30000" KeyboardNavigation.IsTabStop="True"
                                                AutomationProperties.Name="{local:T 'Cosa vogliono dire le scelte', 'What the choices mean'}"
                                                AutomationProperties.HelpText="{local:T 'Fallo da solo: OptLife la fa appena serve, senza chiedere. Chiedimi prima: compare un pulsante e la fai tu, quando vuoi. Mai: il pulsante non c\'è e OptLife non la fa.', 'Do it by itself: OptLife does it as soon as it is needed, without asking. Ask me first: a button appears and you do it, when you want. Never: there is no button and OptLife does not do it.'}"
                                                ToolTip="{local:T 'Fallo da solo: OptLife la fa appena serve, senza chiedere. Chiedimi prima: compare un pulsante e la fai tu, quando vuoi. Mai: il pulsante non c\'è e OptLife non la fa.', 'Do it by itself: OptLife does it as soon as it is needed, without asking. Ask me first: a button appears and you do it, when you want. Never: there is no button and OptLife does not do it.'}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE9CE;" FontSize="14" Foreground="{DynamicResource Text.Secondary}" Margin="4"/>
                                        </Border>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Actions}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,12,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.3*" MinWidth="140"/>
                                                        <ColumnDefinition Width="*" MaxWidth="420"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,24,0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" FontSize="12.5" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <ListBox Grid.Column="1" Style="{StaticResource Choices}" VerticalAlignment="Top" HorizontalAlignment="Right" MaxWidth="420"
                                                             ItemsSource="{Binding Options}" SelectedItem="{Binding Allowed}" AutomationProperties.Name="{Binding Name}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Visibility="{Binding HasSettings, Converter={StaticResource Vis}}">
                                    <Border Height="1" Background="{DynamicResource Outline.Subtle}" Margin="0,16,0,0"/>
                                    <ItemsControl ItemsSource="{Binding Settings}" Focusable="False" ItemTemplate="{StaticResource SettingRow}"/>
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ModuleSaveRow}" Focusable="False"/>
                                </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- Back to the top: shows once the page has been scrolled more than a screen (also Ctrl+Home) -->
        <Button x:Name="TopButton" Grid.Row="3" Style="{StaticResource BtnGhost}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,34,20"
                Visibility="Collapsed" Click="TopButton_Click" Background="{DynamicResource Surface.Flyout}"
                ToolTip="{local:T 'Torna all\'inizio della pagina (Ctrl+Home)', 'Back to the top of the page (Ctrl+Home)'}"
                AutomationProperties.Name="{local:T 'Torna su', 'Back to top'}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE74A;" FontSize="13"/>
                <TextBlock Text="{local:T 'Torna su', 'Back to top'}" Margin="8,0,0,0"/>
            </StackPanel>
        </Button>
        </Grid>
        </Border>

        <!-- ══ GUIDED TOUR: the first time (and from Settings), page by page ══ -->
        <Grid x:Name="TourLayer" Grid.ColumnSpan="2" Visibility="{Binding ShowWelcome, Converter={StaticResource Vis}}">
            <!-- The window dimmed, with a hole where the step points (set by the window) -->
            <Path x:Name="TourDim" Fill="#A6000000" IsHitTestVisible="True"/>
            <Canvas IsHitTestVisible="False">
                <Rectangle x:Name="TourRing" Stroke="{DynamicResource Accent}" StrokeThickness="2" RadiusX="8" RadiusY="8" Visibility="Collapsed"/>
            </Canvas>
            <Border x:Name="TourCard" Background="{DynamicResource Surface.Flyout}" BorderBrush="{DynamicResource Outline.Strong}"
                    Width="500" MaxHeight="640" Margin="24" Padding="26,22"
                    DataContext="{Binding TourStepNow}" KeyboardNavigation.TabNavigation="Cycle"
                    AutomationProperties.Name="{Binding Title}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <!-- Beside what it points at (bottom right); in the middle when it points at nothing -->
                        <Setter Property="VerticalAlignment" Value="Bottom"/>
                        <Setter Property="HorizontalAlignment" Value="Right"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Highlight}" Value="">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.35" Color="Black"/>
                </Border.Effect>
                <DockPanel>
                    <!-- Skip, back, next -->
                    <Grid DockPanel.Dock="Bottom" Margin="0,18,0,0">
                        <Button Style="{StaticResource BtnSubtle}" HorizontalAlignment="Left" Margin="-8,0,0,0" Content="{local:T 'Salta la visita', 'Skip the tour'}"
                                Command="{Binding DataContext.TourSkipCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="{local:T 'Si rifà da Impostazioni', 'It can be taken again from Settings'}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource BtnGhost}" Content="{local:T Indietro, Back}" Margin="0,0,8,0"
                                    Command="{Binding DataContext.TourBackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Visibility="{Binding DataContext.TourIsFirst, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}, ConverterParameter=not}"/>
                            <Button x:Name="TourNextButton" Style="{StaticResource BtnPrimary}" IsDefault="True"
                                    Command="{Binding DataContext.TourNextCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Button.Content>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{local:T Avanti, Next}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.TourIsLast, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                        <Setter Property="Text" Value="{local:T Fine, Finish}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button.Content>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding DataContext.TourCounter, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Caps}"/>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Subtitle}" FontSize="22" Margin="0,4,0,0"
                                       AutomationProperties.HeadingLevel="Level1" AutomationProperties.LiveSetting="Assertive"/>
                            <TextBlock Text="{Binding Text}" Style="{StaticResource Secondary}" Margin="0,6,0,0"/>

                            <!-- Look: language, background, accent (they apply at once) -->
                            <StackPanel Visibility="{Binding Kind, Converter={StaticResource Is}, ConverterParameter=Look}">
                                <TextBlock Text="{local:T Lingua, Language}" Style="{StaticResource Caps}" Margin="0,18,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource SwatchChoice}" Tag="{Binding DataContext.IsItalian, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="Italiano"
                                            Command="{Binding DataContext.SetLanguageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="it">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentControl Content="{StaticResource FlagIt}" Width="27" Height="18" Margin="0,0,10,0" Focusable="False"/>
                                            <TextBlock Text="Italiano" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SwatchChoice}" Tag="{Binding DataContext.IsEnglish, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="English"
                                            Command="{Binding DataContext.SetLanguageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="en">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentControl Content="{StaticResource FlagEn}" Width="27" Height="18" Margin="0,0,10,0" Focusable="False"/>
                                            <TextBlock Text="English" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="{local:T 'Sfondo (consigliato: Windows)', 'Background (suggested: Windows)'}" Style="{StaticResource Caps}" Margin="0,12,0,8"/>
                                <ItemsControl ItemsSource="{Binding DataContext.ThemeBases, RelativeSource={RelativeSource AncestorType=Window}}" Focusable="False">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SwatchChoice}" Tag="{Binding IsSelected}" AutomationProperties.Name="{Binding Name}"
                                                    Command="{Binding DataContext.SetThemeBaseCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="16" Height="16" CornerRadius="4" Background="{Binding Swatch}" BorderBrush="{DynamicResource Outline.Strong}" BorderThickness="1" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{local:T 'Colore d\'accento (consigliato: quello di Windows)', 'Accent colour (suggested: the Windows one)'}" Style="{StaticResource Caps}" Margin="0,4,0,8"/>
                                <ItemsControl ItemsSource="{Binding DataContext.ThemeAccents, RelativeSource={RelativeSource AncestorType=Window}}" Focusable="False">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SwatchChoice}" Tag="{Binding IsSelected}" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"
                                                    Command="{Binding DataContext.SetThemeAccentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}">
                                                <Border Width="16" Height="16" CornerRadius="8" Background="{Binding Swatch}" BorderBrush="{DynamicResource Outline.Strong}" BorderThickness="1"/>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Questions of the step, the suggested answer already in place -->
                            <ItemsControl ItemsSource="{Binding Fields}" Margin="0,8,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,10,0,0">
                                            <TextBlock x:Name="Question" Text="{Binding Question}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding BoolValue}" Margin="0,6,0,0" HorizontalAlignment="Left"
                                                      AutomationProperties.LabeledBy="{Binding ElementName=Question}"
                                                      Visibility="{Binding IsBool, Converter={StaticResource Vis}}"/>
                                            <ListBox Style="{StaticResource Choices}" ItemsSource="{Binding Options}" SelectedItem="{Binding Value}" Margin="-4,6,0,0" HorizontalAlignment="Left"
                                                     AutomationProperties.LabeledBy="{Binding ElementName=Question}"
                                                     Visibility="{Binding IsChoice, Converter={StaticResource Vis}}">
                                                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                            </ListBox>
                                            <StackPanel Margin="0,6,0,0" Visibility="{Binding IsPick, Converter={StaticResource Vis}}">
                                                <ComboBox Style="{StaticResource Pick}" ItemsSource="{Binding Picks}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding PickedValue}"
                                                          AutomationProperties.LabeledBy="{Binding ElementName=Question}"/>
                                                <Button Style="{StaticResource BtnSubtle}" HorizontalAlignment="Left" Margin="-6,4,0,0" Click="Browse_Click" Visibility="{Binding IsFolder, Converter={StaticResource Vis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="13"/>
                                                        <TextBlock Text="{local:T Sfoglia…, Browse…}" Margin="8,0,0,0"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                            <TextBox Style="{StaticResource Field}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"
                                                     AutomationProperties.LabeledBy="{Binding ElementName=Question}"
                                                     Visibility="{Binding IsText, Converter={StaticResource Vis}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Summary: every answer, with "Change" -->
                            <StackPanel Visibility="{Binding Kind, Converter={StaticResource Is}, ConverterParameter=Summary}" Margin="0,12,0,0">
                                <Grid Margin="0,6">
                                    <StackPanel Margin="0,0,90,0">
                                        <TextBlock Text="{local:T Aspetto, Look}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding DataContext.TourLookSummary, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Secondary}"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource BtnGhost}" Content="{local:T Cambia, Change}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Command="{Binding DataContext.TourChangeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding DataContext.TourSteps[0], RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding DataContext.TourAnswered, RelativeSource={RelativeSource AncestorType=Window}}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6">
                                                <StackPanel Margin="0,0,90,0">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Answers}" Style="{StaticResource Secondary}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button Style="{StaticResource BtnGhost}" Content="{local:T Cambia, Change}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        AutomationProperties.HelpText="{Binding Title}"
                                                        Command="{Binding DataContext.TourChangeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>


        <!-- ══ CAPTION BUTTONS ════════════════════════════════════════════ -->
        <StackPanel x:Name="CaptionButtons" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Click="MinButton_Click"
                    ToolTip="{local:T Riduci a icona, Minimise}" AutomationProperties.Name="{local:T Riduci a icona, Minimise}">
                <TextBlock Style="{StaticResource Icon}" FontSize="10" Text="&#xE921;"/>
            </Button>
            <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Click="MaxButton_Click"
                    AutomationProperties.Name="{local:T Ingrandisci, Maximise}">
                <TextBlock x:Name="MaxGlyph" Style="{StaticResource Icon}" FontSize="10" Text="&#xE922;"/>
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource CaptionClose}" Click="CloseButton_Click"
                    ToolTip="{local:T Chiudi, Close}" AutomationProperties.Name="{local:T Chiudi, Close}">
                <TextBlock Style="{StaticResource Icon}" FontSize="10" Text="&#xE8BB;"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
